+class ReferenceSerializationServiceTests(unittest.TestCase):
+    def test_service_preserves_mime_slot_and_error_order(self):
+        from domain import white_model_service as service
+        with tempfile.TemporaryDirectory() as td:
+            root = Path(td)
+            self.assertEqual(service.reference_entries(None), [])
+            self.assertEqual(service.reference_entries({}), [])
+            for suffix, mime in (('.mp4','video/mp4'),('.webm','video/webm'),('.mov','video/quicktime')):
+                path = root / ('clip' + suffix.upper())
+                path.write_bytes(b'media-fixture')
+                expected = 'data:' + mime + ';base64,' + base64.b64encode(b'media-fixture').decode()
+                self.assertEqual(service.reference_data_url(path), expected)
+                explicit = root / 'clip.binary'; explicit.write_bytes(b'media-fixture')
+                self.assertEqual(service.reference_data_url(explicit, suffix.upper()), expected)
+                row = {'path':str(path),'slot':'media'}
+                self.assertEqual(service.reference_entries(row), [{'type':'reference_video','url':expected}])
+                row['slot']='content'
+                self.assertEqual(service.reference_entries(row), [{'type':'video_url','video_url':{'url':expected},'role':'reference_video'}])
+                row['slot']='unknown'
+                with self.assertRaisesRegex(ValueError,'不认识的参考视频槽位'):
+                    service.reference_entries(row)
+            missing = {'path':str(root/'missing.mp4'),'slot':'unknown'}
+            with self.assertRaises(FileNotFoundError):
+                service.reference_entries(missing)
+            self.assertEqual(white_model_ref.MIME, service.REFERENCE_MIME)
+            self.assertIs(white_model_ref.MIME, service.REFERENCE_MIME)
+            self.assertEqual(white_model_ref.prompt_line(None), service.reference_prompt_line(None))
+
+    def test_actual_shot_prepare_white_branch_never_imports_ui(self):
+        import subprocess
+        script = r'''
+import importlib.abc, json, sys, tempfile
+from pathlib import Path
+class DenyUi(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname == 'ui' or fullname.startswith('ui.') or fullname in ('white_model_ref','white_model'):
+            raise AssertionError('L2 must not import UI: ' + fullname)
+sys.meta_path.insert(0, DenyUi())
+from agent.shot_assets import prepare
+with tempfile.TemporaryDirectory() as td:
+    project=Path(td)/'p'; source=project/'episode'/'episode.json'
+    source.parent.mkdir(parents=True)
+    (source.parent/'assets.json').write_text('{}',encoding='utf-8')
+    (project/'config.json').write_text(json.dumps({'episode_dir':str(source.parent),'episode_file':str(source)}),encoding='utf-8')
+    shot={'id':'SH001','duration':5,'characters':[],'frame':'frames/SH001.png','video_prompt':'fixture','upload_assets':False,'generate_audio':True}
+    reference={'path':str(project/'reference.mp4'),'provider':'volcengine','slot':'content'}
+    result=prepare(source,shot,{'model':'doubao-seedance-2-0-pro','cloud_provider':'volcengine'},white=reference)
+    assert result['_white_model_reference'] is reference
+    assert result['_reference_mode']=='seedance'
+    assert '白模预演视频' in result['video_prompt']
+    assert '不复制白模的外观与材质' in result['video_prompt']
+assert not any(name=='ui' or name.startswith('ui.') for name in sys.modules)
+'''
+        result = subprocess.run([sys.executable,'-B','-c',script],cwd=Path(HERE).parent, capture_output=True,timeout=30)
+        self.assertEqual(result.returncode,0,result.stderr.decode('utf-8',errors='replace'))
+
+
