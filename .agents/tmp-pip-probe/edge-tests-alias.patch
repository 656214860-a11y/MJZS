 class TableTests(unittest.TestCase):
+    def test_stage_gate_aliases_preserve_exact_directory_semantics_without_l3_facade(self):
+        """目录别名由L0事实提供，L2独立导入不得要求L3兼容门面。"""
+        import builtins
+        import runpy
+        from contract import stage_layout
+        original_import = builtins.__import__
+
+        def without_facade(name, globals=None, locals=None, fromlist=(), level=0):
+            if name == 'orchestrator.legacy_compat':
+                raise ImportError('L3 facade is unavailable to L2')
+            return original_import(name, globals, locals, fromlist, level)
+
+        with mock.patch.object(builtins, '__import__', side_effect=without_facade):
+            isolated = runpy.run_path(cg.__file__, run_name='confirm_gate_alias_probe')
+        stage_gates = isolated['stage_gates']
+        for old, current in stage_layout.LEGACY_STAGE_ALIASES.items():
+            with self.subTest(old=old):
+                self.assertEqual(stage_gates(old), stage_gates(current))
+        for unknown in (' 02_assets', '02_assets ', '02_assets/', '02_ASSETS', 'unknown', None, 0, False, 123):
+            with self.subTest(unknown=unknown):
+                self.assertEqual(stage_gates(unknown), ())
+        for row in stage_layout.STAGES:
+            expected = tuple(gate['id'] for gate in cg.GATES
+                             if row[0] in cg.GATE_STAGES.get(gate['id'], ()))
+            self.assertEqual(stage_gates(row[0]), expected)
+
     def test_the_gate_table_is_the_delivery_table(self):
         rows = cg.table_rows()
         self.assertEqual(len(rows), 9)
