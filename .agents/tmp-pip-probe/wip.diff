+class ReferenceSerializationServiceTests(unittest.TestCase):
+    def test_service_preserves_mime_slot_and_error_order(self):
+        from domain import white_model_service as service
+        with tempfile.TemporaryDirectory() as td:
+            root = Path(td)
+            self.assertEqual(service.reference_entries(None), [])
+            self.assertEqual(service.reference_entries({}), [])
+            for suffix, mime in (('.mp4','video/mp4'),('.webm','video/webm'),('.mov','video/quicktime')):
+                path = root / ('clip' + suffix.upper())
+                path.write_bytes(b'media-fixture')
+                expected = 'data:' + mime + ';base64,' + base64.b64encode(b'media-fixture').decode()
+                self.assertEqual(service.reference_data_url(path), expected)
+                explicit = root / 'clip.binary'; explicit.write_bytes(b'media-fixture')
+                self.assertEqual(service.reference_data_url(explicit, suffix.upper()), expected)
+                row = {'path':str(path),'slot':'media'}
+                self.assertEqual(service.reference_entries(row), [{'type':'reference_video','url':expected}])
+                row['slot']='content'
+                self.assertEqual(service.reference_entries(row), [{'type':'video_url','video_url':{'url':expected},'role':'reference_video'}])
+                row['slot']='unknown'
+                with self.assertRaisesRegex(ValueError,'不认识的参考视频槽位'):
+                    service.reference_entries(row)
+            missing = {'path':str(root/'missing.mp4'),'slot':'unknown'}
+            with self.assertRaises(FileNotFoundError):
+                service.reference_entries(missing)
+            self.assertEqual(white_model_ref.MIME, service.REFERENCE_MIME)
+            self.assertIs(white_model_ref.MIME, service.REFERENCE_MIME)
+            self.assertEqual(white_model_ref.prompt_line(None), service.reference_prompt_line(None))
+
