+
+def reference_data_url(path, suffix=None):
+    """把已明确提供的白模视频读为data URL，不发现目录或改变原异常语义。"""
+    path = Path(path)
+    mime = REFERENCE_MIME.get(str(suffix or path.suffix).lower())
+    if not mime:
+        raise ValueError('白模视频只认 mp4／webm／mov：' + path.name)
+    return 'data:' + mime + ';base64,' + base64.b64encode(path.read_bytes()).decode()
+
+
+def reference_entries(reference):
+    """保持原接口槽位形状与先读文件后判断slot的顺序。"""
+    if not reference:
+        return []
+    url = reference_data_url(reference['path'], reference.get('suffix'))
+    slot = reference.get('slot')
+    if slot == 'media':
+        return [{'type': 'reference_video', 'url': url}]
+    if slot == 'content':
+        return [{'type': 'video_url', 'video_url': {'url': url}, 'role': 'reference_video'}]
+    raise ValueError('不认识的参考视频槽位：' + repr(slot))
+
+
+def reference_prompt_line(reference=None):
+    return ('白模预演视频＝本镜的动作与机位参考：人物站位、动作起止、镜头运动照它走；'
+            '只借动作与机位，不复制白模的外观与材质。')
