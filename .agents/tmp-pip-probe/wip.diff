+"""C6启动期受信扩展必须同时具备handler、依赖声明和真实成果核验。"""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from contract import pet_bus, stage_layout
+from orchestrator import stage_handler_registry as registry
+from orchestrator import stage_completion_service as completion
+
+
+class StageExtensionSafetyTests(unittest.TestCase):
+    def setUp(self):
+        self.folder = tempfile.TemporaryDirectory()
+        self.addCleanup(self.folder.cleanup)
+        self.root = Path(self.folder.name)
+        self.baseline = (pet_bus.STAGES, pet_bus.STAGE_NAMES, stage_layout.STAGES)
+        for name, value in (('REGISTRY', registry.StageRegistry()),
+                            ('HANDLERS', dict(registry.HANDLERS)),
+                            ('STAGES', registry.STAGES),
+                            ('_CATALOG_SEALED', False), ('_CATALOG_STARTED', False),
+                            ('_DEPENDENCY_CHECKER', None), ('_SEALED_EXTENSIONS', {})):
+            target = patch.object(registry, name, value, create=True)
+            target.start(); self.addCleanup(target.stop)
+        for module, name in ((pet_bus, 'STAGE_DEFINITIONS'), (pet_bus, 'STAGES'),
+                             (pet_bus, 'STAGE_NAMES'), (stage_layout, 'STAGES')):
+            target = patch.object(module, name, getattr(module, name))
+            target.start(); self.addCleanup(target.stop)
+        phase = patch.object(registry, '_ensure_stage_bootstrap_phase')
+        phase.start(); self.addCleanup(phase.stop)
+        evidence_catalog = patch.object(completion, '_EXTENSION_COMPLETION_CATALOG', {})
+        evidence_catalog.start(); self.addCleanup(evidence_catalog.stop)
+        self.handler = SimpleNamespace(**{name: Mock(return_value=name) for name in
+                                         ('start', 'pause', 'resume', 'cancel', 'progress')})
+        from contract.stage_path_service import write_dir
+        self.handler.validate_completion = lambda project: ((write_dir(project, 'extension') / 'output' / 'actual.txt').is_file(), 'missing actual')
+        self.host = SimpleNamespace(root=self.root, pet=SimpleNamespace(bus=SimpleNamespace(begin_run=Mock()), _emit=Mock()))
+
+    def definition(self, dependencies=()):
+        return pet_bus.StageDefinition('14安全扩展', 'extension', '扩展', 'fixture', (), ('actual.txt',),
+                                       dependencies=dependencies)
+
+    def register(self, dependencies=()):
+        registry.register_stage(self.definition(dependencies), self.handler)
+        registry.seal_stage_catalog(completion_checker=lambda project, stage: completion.completion_evidence(project, stage),
+                                    completion_binder=completion.bind_extension_completion_catalog)
+
+    def start(self, trigger='manual'):
+        with patch.object(registry, '_workflow_lock_error', return_value=''), \
+                patch.object(registry.stage_flow, 'unchecked', return_value=False), \
+                patch.object(registry, 'require_output_space'):
+            return registry.start(self.host, 'extension', trigger)
+
+    def test_one_record_and_handler_reaches_start_and_verified_actual_completion(self):
+        self.register()
+        self.assertEqual(pet_bus.STAGES[-1], 'extension')
+        self.assertEqual(stage_layout.STAGES[-1][0], '14安全扩展')
+        self.assertEqual(self.start(), 'start')
+        self.handler.start.assert_called_once()
+        self.assertEqual(registry.dispatch(registry.StageContext(self.host, 'extension'), operation='progress'), 'progress')
+        emitted = Mock()
+        self.assertFalse(completion.emit_verified_completion(self.root, 'extension', 'done', emitted)[0])
+        emitted.assert_not_called()
+        from contract.stage_path_service import write_dir
+        output = write_dir(self.root, 'extension') / 'output' / 'actual.txt'
+        output.parent.mkdir(parents=True)
+        output.write_text('actual', encoding='utf-8')
+        self.assertTrue(completion.emit_verified_completion(self.root, 'extension', 'done', emitted)[0])
+        emitted.assert_called_once_with('stage.completed', stage='extension', text='done')
+
+    def test_missing_dependencies_validator_and_incomplete_handler_reject_before_mutation(self):
+        before = registry.REGISTRY.definitions
+        with self.assertRaises(ValueError):
+            registry.register_stage(self.definition(None), self.handler)
+        self.assertEqual(registry.REGISTRY.definitions, before)
+        del self.handler.validate_completion
+        with self.assertRaises(ValueError):
+            registry.register_stage(self.definition(), self.handler)
+        self.handler.validate_completion = lambda project: (True, '')
+        del self.handler.cancel
+        with self.assertRaises(TypeError):
+            registry.register_stage(self.definition(), self.handler)
+        self.assertEqual(registry.REGISTRY.definitions, before)
+
+    def test_unknown_dependency_and_duplicate_directory_are_atomic_rejections(self):
+        before = (registry.REGISTRY.definitions, dict(registry.REGISTRY.handlers))
+        with self.assertRaises(ValueError):
+            registry.register_stage(self.definition(('unknown',)), self.handler)
+        duplicate = pet_bus.StageDefinition('01剧本准备', 'extension', '扩展', '', (), (), dependencies=())
+        with self.assertRaises(ValueError):
+            registry.register_stage(duplicate, self.handler)
+        self.assertEqual((registry.REGISTRY.definitions, registry.REGISTRY.handlers), before)
+
+    def test_existing_dependencies_must_have_verified_outputs(self):
+        self.register(('script',))
+        with patch.object(completion, 'completion_evidence', return_value=(False, 'missing')) as evidence:
+            self.assertIn('script', self.start())
+            evidence.assert_called_once_with(self.root, 'script')
+        self.handler.start.assert_not_called()
+        with patch.object(completion, 'completion_evidence', return_value=(True, '')):
+            self.assertEqual(self.start(), 'start')
+
+    def test_sealed_catalog_uses_startup_mapping_snapshot(self):
+        self.register()
+        replacement = SimpleNamespace(**{name: Mock() for name in ('start','pause','resume','cancel','progress')})
+        registry.REGISTRY.handlers['extension'] = replacement
+        registry.HANDLERS['extension'] = replacement
+        self.assertEqual(self.start(), 'start')
+        replacement.start.assert_not_called()
+        self.assertIs(registry.extension_handler_for('extension'), self.handler)
+
+    def test_auto_defaults_to_disabled_and_start_freezes_new_registration(self):
+        self.register()
+        self.assertIn('自动', self.start('auto'))
+        self.handler.start.assert_not_called()
+        with self.assertRaises(RuntimeError):
+            registry.register_stage(pet_bus.StageDefinition('15其它', 'other', '其它', '', (), (), dependencies=()), self.handler)
+
+    def test_dependency_checker_is_explicit_and_missing_checker_cannot_publish(self):
+        registry.register_stage(self.definition(('script',)), self.handler)
+        with self.assertRaises(ValueError):
+            registry.seal_stage_catalog()
+        self.assertIs(pet_bus.STAGES, self.baseline[0])
+        self.assertFalse(registry._CATALOG_SEALED)
+
+    def test_seal_rejects_mutating_original_stage_facts(self):
+        from dataclasses import replace
+        registry.REGISTRY._definitions[0] = replace(registry.REGISTRY.definitions[0], name='changed')
+        with self.assertRaises(ValueError):
+            registry.seal_stage_catalog()
+        self.assertIs(pet_bus.STAGES, self.baseline[0])
+        self.assertFalse(registry._CATALOG_SEALED)
+
+    def test_direct_local_registry_cannot_bypass_safe_seal_and_windows_names(self):
+        for outputs in (('CON.txt',), ('name.',), ('A.txt', 'a.txt')):
+            with self.subTest(outputs=outputs):
+                definition = pet_bus.StageDefinition('14安全扩展', 'extension', '扩展', '', (), outputs, dependencies=())
+                with self.assertRaises(ValueError):
+                    registry.register_stage(definition, self.handler)
+        registry.REGISTRY.register(self.definition(None), self.handler)
+        with self.assertRaises(ValueError):
+            registry.seal_stage_catalog(completion_binder=completion.bind_extension_completion_catalog)
+        self.assertFalse(registry._CATALOG_SEALED)
+        self.assertIs(pet_bus.STAGES, self.baseline[0])
+
+    def test_extension_start_exceptions_and_cancellation_propagate(self):
+        self.register()
+        self.handler.start.side_effect = RuntimeError('start failed')
+        with self.assertRaisesRegex(RuntimeError, 'start failed'):
+            self.start()
+        self.handler.cancel.side_effect = RuntimeError('cancel failed')
+        with self.assertRaisesRegex(RuntimeError, 'cancel failed'):
+            registry.dispatch(registry.StageContext(self.host, 'extension'), operation='stop')
+
+    def test_completion_binder_is_required_and_failure_does_not_publish(self):
+        registry.register_stage(self.definition(), self.handler)
+        with self.assertRaises(ValueError):
+            registry.seal_stage_catalog()
+        self.assertIs(pet_bus.STAGES, self.baseline[0])
+        with self.assertRaisesRegex(RuntimeError, 'binder failed'):
+            registry.seal_stage_catalog(completion_binder=Mock(side_effect=RuntimeError('binder failed')))
+        self.assertIs(pet_bus.STAGES, self.baseline[0])
+        self.assertFalse(registry._CATALOG_SEALED)
+
+    def test_original_facts_and_no_extension_seal_preserve_identity(self):
+        registry.seal_stage_catalog()
+        self.assertIs(pet_bus.STAGES, self.baseline[0])
+        self.assertIs(pet_bus.STAGE_NAMES, self.baseline[1])
+        self.assertIs(stage_layout.STAGES, self.baseline[2])
+
+    def test_extra_source_stage_never_gets_implicit_legacy_handler(self):
+        with patch.object(pet_bus, 'STAGE_DEFINITIONS', pet_bus.STAGE_DEFINITIONS + (self.definition(),)):
+            with self.assertRaises(ValueError):
+                registry.StageRegistry()
+
+    def test_declared_outputs_required_even_when_validator_claims_complete(self):
+        self.register()
+        completion._EXTENSION_COMPLETION_CATALOG['extension'] = (self.definition(), lambda project: (True, ''))
+        self.assertFalse(completion.completion_evidence(self.root, 'extension')[0])
+        from contract.stage_path_service import write_dir
