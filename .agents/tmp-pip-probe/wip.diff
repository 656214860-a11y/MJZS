+"""C6真实自动ticket owner：阶段/项目隔离与不支持暂停不伪发事件。"""
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from orchestrator import stage_handler_registry as registry
+from orchestrator.desktop_automation_service import BackgroundTaskLifecycle
+from ui.pet_ui_stages import PetStagesMixin
+
+
+class Host:
+    pass
+
+
+class TaskOwnerTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.host = Host()
+        self.host.root = Path(self.temp.name) / 'project'
+
+    def bind(self, stage, ticket=1, tasks=None):
+        tasks = tasks or BackgroundTaskLifecycle()
+        tasks.submit(ticket)
+        owner = registry.bind_task_owner(self.host, stage, tasks, ticket)
+        return tasks, owner
+
+    def test_projects_and_stages_are_exact_and_progress_is_lifecycle_snapshot(self):
+        assets, owner = self.bind('assets')
+        video, _ = self.bind('video', 2)
+        result = registry.control_task(self.host, 'assets', 'progress')
+        self.assertEqual(result['lifecycle'], assets.snapshot())
+        self.assertEqual(result['ticket'], 1)
+        self.assertEqual(result['stage'], 'assets')
+        self.assertNotIn('percent', result)
+        self.assertIs(registry.task_owner_for(self.host, 'assets'), owner)
+        self.assertTrue(registry.control_task(self.host, 'assets', 'cancel')['local_wait_stopped'])
+        self.assertTrue(video.accepts(2))
+        self.host.root = Path(self.temp.name) / 'other'
+        self.assertIsNone(registry.task_owner_for(self.host, 'video'))
+        self.assertIs(registry.control_task(self.host, 'video', 'cancel'), NotImplemented)
+        self.assertTrue(video.accepts(2))
+
+    def test_replaced_and_late_owner_cannot_cancel_new_ticket_or_different_binding(self):
+        tasks, old = self.bind('assets', 1)
+        tasks.submit(2)
+        new = registry.bind_task_owner(self.host, 'assets', tasks, 2)
+        ctx = registry.StageContext(self.host, 'assets', owner=old)
+        self.assertIs(old.cancel(ctx), NotImplemented)
+        self.assertTrue(tasks.accepts(2))
+        self.assertIs(registry.task_owner_for(self.host, 'assets'), new)
+        other = BackgroundTaskLifecycle(); other.submit(2)
+        registry.bind_task_owner(self.host, 'assets', other, 2)
+        self.assertIs(new.cancel(ctx), NotImplemented)
+        self.assertTrue(tasks.accepts(2)); self.assertTrue(other.accepts(2))
+
+    def test_reusing_the_same_ticket_number_does_not_revive_old_owner(self):
+        tasks, owner = self.bind('assets', 1)
+        tasks.submit(1)
+        ctx = registry.StageContext(self.host, 'assets', owner=owner)
+        self.assertIs(owner.cancel(ctx), NotImplemented)
+        self.assertTrue(tasks.accepts(1))
+
+    def test_project_switch_invalidates_frozen_owner_without_cancelling_work(self):
+        tasks, owner = self.bind('assets')
+        self.host.root = Path(self.temp.name) / 'other'
+        ctx = registry.StageContext(self.host, 'assets', owner=owner)
+        self.assertIs(owner.cancel(ctx), NotImplemented)
+        self.assertIs(owner.progress(ctx), NotImplemented)
+        self.assertTrue(tasks.accepts(1))
+
+    def test_cancel_is_local_wait_only_and_never_confirms_remote_cancel(self):
+        tasks = BackgroundTaskLifecycle(); tasks.submit(3, remote_task_id='remote-fixture', costly=True)
+        registry.bind_task_owner(self.host, 'assets', tasks, 3)
+        result = registry.control_task(self.host, 'assets', 'cancel')
+        self.assertTrue(result['local_wait_stopped'])
+        self.assertFalse(result['remote_cancel_confirmed'])
+        self.assertFalse(tasks.cancellation_status(3)['remote_cancel_confirmed'])
+        self.assertFalse(tasks.accepts(3))
+
+    def test_old_remote_confirmation_is_not_reused_for_same_numeric_ticket(self):
+        tasks=BackgroundTaskLifecycle()
+        tasks.submit(4,remote_task_id='old-remote')
+        tasks.cancel(4,remote_cancel_confirmed=True)
+        tasks.submit(4)
+        registry.bind_task_owner(self.host,'assets',tasks,4)
+        result=registry.control_task(self.host,'assets','cancel')
+        self.assertTrue(result['local_wait_stopped'])
+        self.assertFalse(result['remote_cancel_requested'])
+        self.assertFalse(result['remote_cancel_confirmed'])
+
+    def test_unsupported_pause_does_not_emit_or_clear_running(self):
+        self.bind('assets')
+        pet = SimpleNamespace(desktop=self.host, _emit=Mock())
+        with patch.object(registry.stage_flow, 'OWN_ORDER', ('assets',)), \
+                patch.dict(registry.stage_flow.RUNNING, {'assets':'auto'}, clear=True):
+            self.assertEqual(PetStagesMixin.pause_running_stage(pet), [])
+            self.assertEqual(registry.stage_flow.RUNNING, {'assets':'auto'})
+        pet._emit.assert_not_called()
+        self.assertTrue(registry.control_task(self.host, 'assets', 'progress')['lifecycle']['state'] == 'running')
+
+    def test_only_confirmed_real_pause_stages_emit_paused(self):
+        pet = SimpleNamespace(desktop=self.host, _emit=Mock())
+        with patch.object(registry.stage_flow, 'OWN_ORDER', ('assets','video','edit')), \
+                patch.object(registry.stage_flow, 'running', return_value=True), \
+                patch.object(registry, 'control_task', side_effect=(True, NotImplemented, False)):
+            self.assertEqual(PetStagesMixin.pause_running_stage(pet), ['assets'])
+        pet._emit.assert_called_once_with('stage.paused', stage='assets')
+
+
+class AutomaticSubmissionBindingTests(unittest.TestCase):
+    def test_five_existing_submission_paths_bind_their_exact_stage_and_ticket(self):
+        import queue
+        from ui import desktop_auto_flows as flows
+        from orchestrator.desktop_auto_state import create_auto_state
+        methods=(('edit','poll_auto_edit'),('previs','poll_auto_previs'),
+                 ('assets','poll_auto_asset'),('video','poll_auto_video'),('delivery','poll_auto_handoff'))
+        for stage,method in methods:
+            with self.subTest(stage=stage), tempfile.TemporaryDirectory() as td:
+                root=Path(td)
+                source=root/'episode.json';source.write_text('{"shots":[]}',encoding='utf-8')
+                auto=create_auto_state(None,stage_queue=lambda *args:queue.Queue(),drain=lambda:None)
+                host=SimpleNamespace(root=root,studio=SimpleNamespace(episode={}),auto=auto,
+                                     pet=SimpleNamespace(should_auto_run=lambda key:True,drain=lambda:None),
+                                     worker=None,status=Mock(),align_studio=lambda:True,final_holding=lambda:False,
+                                     current_frame_json=lambda:source,stage_engine=lambda key:'fixture',
+                                     edit_ready=lambda:('signature','digest'),_previs_last_result=lambda:{},
+                                     asset_base=lambda:root,clear_asset_resume=Mock(),
+                                     _load_scheduled_entries=lambda:None,frame_rows=[],frame_json=None,
+                                     _asset_batch_done=Mock(),_schedule_auto_edit_result_poll=Mock(),
+                                     _schedule_auto_video_result_poll=Mock(),_schedule_auto_handoff_result_poll=Mock())
+                class Bound(BaseException):
+                    pass
+                actual=registry.bind_task_owner
+                def bind(desktop,key,tasks,ticket):
+                    owner=actual(desktop,key,tasks,ticket)
+                    self.assertEqual(key,stage)
+                    self.assertEqual(owner.ticket,ticket)
+                    self.assertTrue(tasks.accepts(ticket))
+                    raise Bound()
+                from contextlib import ExitStack
+                with ExitStack() as stack:
+                    stack.enter_context(patch.object(flows,'bind_task_owner',side_effect=bind))
+                    stack.enter_context(patch('domain.edit_service.automatic_assemble_decision',return_value={'action':'run','signature':'signature'}))
+                    stack.enter_context(patch('domain.handoff_service.automatic_decision',return_value={'action':'run','signature':'signature'}))
+                    stack.enter_context(patch('stage_execution_service.previs_automatic_candidates',return_value={'pending':[{'id':'S1'}],'waiting':[],'medium':[]}))
+                    stack.enter_context(patch('stage_execution_service.previs_automatic_engine',return_value='fixture'))
+                    stack.enter_context(patch('domain.previs_routing.automatic_signature',return_value='signature'))
+                    stack.enter_context(patch('stage_execution_service.plan_unattended_assets',return_value=([('asset',{})],[],{})))
+                    stack.enter_context(patch('domain.asset_context.scope_sources',return_value=[]))
+                    stack.enter_context(patch('domain.asset_batch_service.current_model',return_value='fixture'))
+                    stack.enter_context(patch('domain.asset_batch_service.unattended_signature',return_value='signature'))
+                    stack.enter_context(patch('domain.asset_batch_service.unattended_retry_decision',return_value={'action':'run','signature':'signature'}))
+                    stack.enter_context(patch('domain.asset_resume.attempts',return_value=0))
+                    stack.enter_context(patch('local_video.LocalStudio',SimpleNamespace))
+                    stack.enter_context(patch('local_video.auto_plan',return_value=([{}],[],[])))
+                    stack.enter_context(patch('local_video.auto_poll_decision',return_value={'action':'run','signature':'signature'}))
+                    with self.assertRaises(Bound):
+                        getattr(flows.AutoFlowsMixin,method)(host)
+                self.assertEqual(registry.task_owner_for(host,stage).project,str(root.resolve()))
+
+
+if __name__ == '__main__':
+    unittest.main()
