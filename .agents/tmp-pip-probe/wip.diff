+"""内容解析属主下沉：精确兼容与真实静态层级边回归，不修改旧解析契约。"""
+import unittest
+
+from infra import token_saver
+from tests.architecture import _scan
+
+
+class ContentExtractionOwnerTests(unittest.TestCase):
+    def test_idea_chat_has_no_static_dependency_on_ui_pet_agent(self):
+        targets = {name for _line, name in _scan.resolved_module_import_rows(_scan.entity_file('idea_chat'))}
+        self.assertNotIn('pet_agent', targets)
+        self.assertIn('token_saver', targets)
+
+    def test_existing_pet_agent_name_reexports_the_same_low_layer_function(self):
+        import pet_agent
+        self.assertIs(pet_agent.extract_content, token_saver.extract_content)
+
+    def test_legacy_wire_content_and_priority_are_unchanged(self):
+        cases = [
+            ({'choices': [{'message': {'content': '聊天', 'reasoning_content': '内部'}}]}, '聊天'),
+            ({'output_text': '响应'}, '响应'),
+            ({'output': [{'type': 'message', 'content': [{'type': 'output_text', 'text': '首正文'},
+                                                       {'type': 'output_text', 'text': '次正文'}]}]}, '首正文'),
+            ({'choices': [{'message': {'reasoning_content': '仅推理'}}]}, '仅推理'),
+            ({'choices': [{'message': {'reasoning': '仅推理'}}]}, '仅推理'),
+            ({'choices': [{'message': {'content': {'legacy': 'value'}}}]}, "{'legacy': 'value'}"),
+            ({'choices': [{'message': {'content': [{'type': 'text', 'text': '旧列表'}]}}]},
+             "[{'type': 'text', 'text': '旧列表'}]"),
+        ]
+        for data, expected in cases:
+            with self.subTest(data=data):
+                self.assertEqual(token_saver.extract_content(data), expected)
+
+    def test_legacy_empty_malformed_and_error_payloads_stay_empty(self):
+        cases = [None, [], 'text', {}, {'choices': []}, {'choices': [None]},
+                 {'choices': [{'message': None}]}, {'error': {'message': '错误'}},
+                 {'output': [{'type': 'function_call', 'arguments': 'not body'}]},
+                 {'output': [{'type': 'message', 'content': [None, {'type': 'output_text', 'text': ''}]}]}]
+        for data in cases:
+            with self.subTest(data=data):
+                self.assertEqual(token_saver.extract_content(data), '')
+
+    def test_idea_chat_keeps_native_anthropic_text_and_legacy_fallback(self):
+        from domain import idea_chat
+        native = {'data': {'content': [{'type': 'thinking', 'thinking': '内部'},
+                                      {'type': 'text', 'text': '甲'}, {'type': 'tool_use', 'text': '工具'},
+                                      {'type': 'text', 'text': '乙'}]}}
+        self.assertEqual(idea_chat.reply_text(native), '甲乙')
+        self.assertEqual(idea_chat.reply_text({'data': {'content': [{'type': 'tool_use', 'text': '工具'}]}}), '')
+        self.assertEqual(idea_chat.reply_text({'data': {'choices': [{'message': {'reasoning_content': '仅推理'}}]}}), '仅推理')
+
+
+if __name__ == '__main__':
+    unittest.main()
