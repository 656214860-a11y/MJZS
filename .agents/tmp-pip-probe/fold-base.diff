+
+def initialize_dpi_awareness():
+    """首个 UI 依赖前调用；能力缺失才降级，已设置／真实失败均停止。
+
+    返回 status/api/error，ACCESS_DENIED 只说明已有设置，不冒称已获得 v2。
+    缓存最终观测，重复入口不再次尝试修改进程全局状态。
+    """
+    global _DPI_RESULT
+    if _DPI_RESULT is not None:
+        return dict(_DPI_RESULT)
+    status, api, error = 'not_windows', None, 0
+    if sys.platform == 'win32':
+        import ctypes
+        status = 'unsupported'
+        choices = (('user32', 'SetProcessDpiAwarenessContext', (-4,), [ctypes.c_void_p]),
+                   ('shcore', 'SetProcessDpiAwareness', (2,), [ctypes.c_int]),
+                   ('user32', 'SetProcessDPIAware', (), []))
+        for library, name, args, argtypes in choices:
+            try:
+                function = getattr(ctypes.WinDLL(library, use_last_error=True), name)
+            except (OSError, AttributeError):
+                continue
+            function.argtypes = argtypes
+            function.restype = ctypes.c_long if library == 'shcore' else ctypes.c_int
+            ctypes.set_last_error(0)
+            result = function(*args)
+            error = (int(result) & 0xffffffff) if library == 'shcore' else ctypes.get_last_error()
+            if (result == 0 if library == 'shcore' else bool(result)):
+                status, api, error = 'applied', name, 0
+                break
+            if error in (5, 0x80070005):
+                status, api = 'already_set', name
+                break
+            if error in (87, 120, 127, 0x80070057, 0x80004001):
+                continue  # 老系统不认识该能力，允许尝试下一档。
+            status, api = 'failed', name
+            break
+    _DPI_RESULT = {'status': status, 'api': api, 'error': error}
+    return dict(_DPI_RESULT)
+
+
+def window_dpi(hwnd):
+    """只读当前窗口／系统 DPI；旧系统与非 Windows 返回 None 让 Tk 兜底。"""
+    if sys.platform != 'win32':
+        return None
+    import ctypes
+    try:
+        user = ctypes.WinDLL('user32', use_last_error=True)
+    except OSError:
+        return None
+    for name, args in (('GetDpiForWindow', (hwnd,)), ('GetDpiForSystem', ())):
+        try:
+            function = getattr(user, name)
+            function.argtypes = [ctypes.c_void_p] if args else []
+            function.restype = ctypes.c_uint
+            dpi = float(function(*args))
+        except (AttributeError, OSError, TypeError, ValueError):
+            continue
+        if math.isfinite(dpi) and dpi > 0:
+            return dpi
+    return None
+
