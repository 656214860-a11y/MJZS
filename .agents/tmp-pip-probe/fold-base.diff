@@ -0,0 +1,86 @@
+"""C1：L3 服务失败携码异常，保留既有 ValueError 与成功返回契约。"""
+import unittest
+from unittest.mock import patch
+
+from contract import service_contract
+from contract.error_codes import code_data, lookup
+from orchestrator import workflow_context_controller as controller
+
+
+class AppErrorBoundaryTests(unittest.TestCase):
+    def test_app_error_carries_registered_code_and_original_reason(self):
+        error = service_contract.AppError('E-IO-WRITE', '项目索引无法保存')
+        self.assertIsInstance(error, ValueError)
+        self.assertEqual(error.code, 'E-IO-WRITE')
+        self.assertEqual(error.reason, '项目索引无法保存')
+        self.assertEqual(str(error), error.reason)
+        self.assertTrue(lookup(error.code).retryable)
+
+    def test_unknown_code_uses_existing_registry_fallback(self):
+        for code in ('', 'not-registered'):
+            error = service_contract.AppError(code, '保留原始说明')
+            self.assertEqual(error.code, 'E-UNKNOWN')
+            self.assertEqual(str(error), '保留原始说明')
+
+    def test_both_boundaries_raise_coded_value_error_for_service_failure(self):
+        for entry, target in ((controller.request_stage_instruction, 'request_instruction'),
+                              (controller.publish_writing_context, 'instruction')):
+            with self.subTest(entry=entry.__name__):
+                result = service_contract.SystemError('项目接续索引未能保存',
+                                                      data=code_data('E-IO-WRITE'))
+                with patch('domain.workflow_context.' + target, return_value=result), \
+                        patch.object(controller, 'workflow_context_gateway', return_value={'publish_json': object()}):
+                    with self.assertRaises(ValueError) as caught:
+                        entry('project', 'writing', {})
+                error = caught.exception
+                self.assertIsInstance(error, service_contract.AppError)
+                self.assertEqual(error.code, 'E-IO-WRITE')
+                self.assertEqual(error.reason, result.reason)
+                self.assertEqual(str(error), result.reason)
+                self.assertIs(type(result), service_contract.SystemError)
+                self.assertFalse(isinstance(result, service_contract.UserError))
+
+    def test_legacy_failure_without_code_still_has_original_message(self):
+        for entry, target in ((controller.request_stage_instruction, 'request_instruction'),
+                              (controller.publish_writing_context, 'instruction')):
+            with self.subTest(entry=entry.__name__):
+                result = service_contract.SystemError('请检查磁盘后重试')
+                with patch('domain.workflow_context.' + target, return_value=result), \
+                        patch.object(controller, 'workflow_context_gateway', return_value={'publish_json': object()}):
+                    with self.assertRaises(ValueError) as caught:
+                        entry('project', 'writing', {})
+                self.assertEqual(caught.exception.code, 'E-UNKNOWN')
+                self.assertEqual(str(caught.exception), result.reason)
+
+    def test_success_data_and_injected_publisher_are_unchanged(self):
+        for entry, target, value in ((controller.request_stage_instruction, 'request_instruction', ('正文', 'stage_summary')),
+                                     (controller.publish_writing_context, 'instruction', '正文')):
+            with self.subTest(entry=entry.__name__):
+                publish = object()
+                data = {'snapshot': True}
+                with patch('domain.workflow_context.' + target, return_value=service_contract.success(value)) as call, \
+                        patch.object(controller, 'workflow_context_gateway', return_value={'publish_json': publish}):
+                    self.assertIs(entry('project', 'writing', data), value)
+                call.assert_called_once_with('project', 'writing', data, publish=publish)
+
+    def test_unexpected_programming_error_is_not_wrapped_as_service_failure(self):
+        for entry, target in ((controller.request_stage_instruction, 'request_instruction'),
+                              (controller.publish_writing_context, 'instruction')):
+            with self.subTest(entry=entry.__name__):
+                bug = TypeError('publisher contract broken')
+                with patch('domain.workflow_context.' + target, side_effect=bug), \
+                        patch.object(controller, 'workflow_context_gateway', return_value={'publish_json': object()}):
+                    with self.assertRaises(TypeError) as caught:
+                        entry('project', 'writing', {})
+                self.assertIs(caught.exception, bug)
+
+    def test_service_result_keeps_four_fields_and_failure_categories(self):
+        self.assertEqual(tuple(service_contract.ServiceResult.__dataclass_fields__),
+                         ('ok', 'reason', 'recoverable', 'data'))
+        self.assertTrue(service_contract.is_failure(service_contract.UserError('输入缺失')))
+        self.assertTrue(service_contract.is_failure(service_contract.SystemError('环境故障')))
+        self.assertFalse(service_contract.is_failure(service_contract.Cancelled()))
+
+
+if __name__ == '__main__':
+    unittest.main()
