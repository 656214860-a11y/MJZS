+"""C2 独立存储探测：只读目标盘、明确拒绝低空间或无法确定的空间。"""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from infra import storage_maintenance as storage
+
+
+class DiskSpaceGuardTests(unittest.TestCase):
+    def check(self, free, required=5 * 1024 ** 3, directory='Z:/project-output'):
+        with patch.object(storage.shutil, 'disk_usage', return_value=SimpleNamespace(free=free)) as usage:
+            result = storage.disk_space_status(directory, required)
+        usage.assert_called_once_with(directory)
+        return result
+
+    def test_low_space_refuses_and_explains_free_required_and_action(self):
+        result = self.check(2 * 1024 ** 3)
+        self.assertFalse(result['ok'])
+        self.assertEqual(result['free'], 2 * 1024 ** 3)
+        self.assertEqual(result['required'], 5 * 1024 ** 3)
+        for text in ('当前剩余', '2.00 GiB', '所需', '5.00 GiB', '释放空间', '更换输出盘'):
+            self.assertIn(text, result['message'])
+
+    def test_default_threshold_is_five_gib(self):
+        with patch.object(storage.shutil, 'disk_usage', return_value=SimpleNamespace(free=5 * 1024 ** 3)):
+            result = storage.disk_space_status('Z:/project-output')
+        self.assertTrue(result['ok'])
+        self.assertEqual(result['required'], 5 * 1024 ** 3)
+
+    def test_equal_threshold_passes(self):
+        self.assertTrue(self.check(4096, 4096)['ok'])
+
+    def test_normal_space_passes_without_rejection_advice(self):
+        result = self.check(8 * 1024 ** 3)
+        self.assertTrue(result['ok'])
+        self.assertNotIn('释放空间', result['message'])
+
+    def test_explicit_threshold_is_used_without_persisting_configuration(self):
+        self.assertTrue(self.check(2048, 1024)['ok'])
+        self.assertFalse(self.check(2048, 4096)['ok'])
+
+    def test_unavailable_disk_is_unknown_and_refused(self):
+        with patch.object(storage.shutil, 'disk_usage', side_effect=OSError('not available')) as usage:
+            result = storage.disk_space_status('Z:/project-output', 1024)
+        usage.assert_called_once_with('Z:/project-output')
+        self.assertFalse(result['ok'])
+        self.assertIsNone(result['free'])
+        self.assertEqual(result['required'], 1024)
+        for text in ('当前剩余未知', '所需', '输出盘', '重试'):
+            self.assertIn(text, result['message'])
+        self.assertNotIn('not available', result['message'])
+
+    def test_invalid_threshold_is_rejected_before_disk_query(self):
+        for invalid in (0, -1, True, False, None, 1.5, '1024'):
+            with self.subTest(required=invalid), patch.object(storage.shutil, 'disk_usage') as usage:
+                with self.assertRaises(ValueError):
+                    storage.disk_space_status('Z:/project-output', invalid)
+                usage.assert_not_called()
+
+    def test_probe_never_creates_or_scans_paths(self):
+        with patch.object(storage.Path, 'mkdir', side_effect=AssertionError('must not create')), \
+                patch.object(storage.Path, 'iterdir', side_effect=AssertionError('must not scan')), \
+                patch.object(storage.Path, 'rglob', side_effect=AssertionError('must not scan')), \
+                patch.object(storage.os, 'walk', side_effect=AssertionError('must not scan')):
+            self.assertTrue(self.check(8192, 4096, 'Z:/project-output')['ok'])
+
+
+if __name__ == '__main__':
+    unittest.main()
