+"""REQ-S01-31: every real API entry prepares before transport or metering."""
+import copy
+import tempfile
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import FrozenInstanceError
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+from infra import model_router as router
+import writing_api
+
+
+def record(wire='chat', window=8000):
+    return {'id': 'fixture-id', 'model': 'fixture-model', 'provider': 'custom',
+            'base_url': 'https://fixture.invalid/v1', 'path': '/fixture',
+            'wire_api': wire, 'context_length': window, 'key_env': 'FIXTURE_KEY',
+            'capabilities': [], 'cost': 1, 'rpm': 5}
+
+
+class ModelAdapterPreflightTests(unittest.TestCase):
+    def adapter(self, wire='chat', window=8000):
+        transport = Mock(return_value={'ok': True, 'status': 200, 'data': {
+            'choices': [{'message': {'content': 'ok'}, 'finish_reason': 'stop'}],
+            'content': [{'type': 'text', 'text': 'ok'}], 'output_text': 'ok'}})
+        adapter = router.PoolAdapter(record(wire, window), transport=transport, key='fixture')
+        return adapter, transport
+
+    def test_three_protocols_chat_and_stream_reject_same_unknown_and_oversize(self):
+        for wire in ('chat', 'messages', 'responses'):
+            for method in ('chat', 'stream'):
+                for window, text, reason in ((None, '任务', 'context_window_unknown'),
+                                              (2000, '中' * 2000, 'context_budget_exceeded')):
+                    with self.subTest(wire=wire, method=method, reason=reason):
+                        adapter, transport = self.adapter(wire, window)
+                        with patch('infra.model_router.model_pool.http_stream') as stream:
+                            result = getattr(adapter, method)([{'role': 'user', 'content': text}],
+                                                              {'max_tokens': 100}, model='fixture-model')
+                        self.assertFalse(result['ok'])
+                        self.assertEqual(result['reason'], reason)
+                        self.assertEqual(result['error_class'], reason)
+                        self.assertFalse(result['retryable'])
+                        self.assertEqual(result['status'], 0)
+                        self.assertIn('context_budget', result)
+                        transport.assert_not_called()
+                        stream.assert_not_called()
+
+    def test_gateway_and_router_use_same_actual_boundary(self):
+        for window, text, reason in ((None, '任务', 'context_window_unknown'),
+                                     (2000, '中' * 2000, 'context_budget_exceeded')):
+            transport = Mock()
+            gateway = router.ModelGateway(records={'fixture-model': record(window=window)}, transport=transport)
+            with patch.object(router.PoolAdapter, 'credential', return_value='fixture'):
+                for method in ('chat', 'stream'):
+                    result = getattr(gateway, method)(['fixture-model'], [{'role': 'user', 'content': text}],
+                                                     options={'max_tokens': 100})
+                    self.assertEqual(result['reason'], reason)
+                result = gateway.router.chat('fixture-model', [{'role': 'user', 'content': text}],
+                                             options={'max_tokens': 100})
+            self.assertEqual(result['reason'], reason)
+            transport.assert_not_called()
+
+    def test_final_payload_frozen_and_tools_built_once(self):
+        for wire in ('chat', 'messages', 'responses'):
+            adapter, transport = self.adapter(wire)
+            messages = [{'role': 'user', 'content': '任务'}]
+            options = {'max_tokens': 100, 'tools': [{'name': 'fixture', 'description': '工具'}]}
+            original = copy.deepcopy(adapter.payload('fixture-model', messages, options, '规则'))
+            with patch.object(adapter, 'payload', wraps=adapter.payload) as build:
+                prepared = adapter.prepare_request(messages, options, 'fixture-model', '规则')
+                messages[0]['content'] = '中' * 10000
+                options['tools'][0]['description'] = 'changed'
+                result = adapter.chat(messages, options, 'fixture-model', '规则', prepared=prepared)
+                self.assertEqual(build.call_count, 1)
+            self.assertTrue(result['ok'], result)
+            self.assertEqual(transport.call_args.args[1], original)
+            self.assertEqual(prepared.report['output_reserved'], 100)
+            with self.assertRaises((FrozenInstanceError, AttributeError)):
+                prepared.model = 'changed'
+            report = prepared.report
+            report['context_limit'] = 1
+            self.assertEqual(prepared.report['context_limit'], 8000)
+
+    def test_writing_refuses_before_rpm_and_ledger_construction(self):
+        for window, text, reason in ((None, '任务', 'context_window_unknown'),
+                                     (2000, '中' * 2000, 'context_budget_exceeded')):
+            adapter, transport = self.adapter(window=window)
+            with tempfile.TemporaryDirectory() as folder, \
+                    patch('writing_api.stage_model_value.reasoning_options', return_value={}), \
+                    patch('infra.model_pool.wait_for_rpm') as rpm, \
+                    patch('infra.pet_llm.RequestLedger') as ledger:
+                wrapped = writing_api.WritingRequestAdapter(adapter, record(window=window),
+                                                            'fixture-model', project=Path(folder))
+                result = wrapped.chat([{'role': 'user', 'content': text}], {'max_tokens': 100})
+            self.assertEqual(result['reason'], reason)
+            rpm.assert_not_called()
+            ledger.assert_not_called()
+            transport.assert_not_called()
+            self.assertEqual(result['request_usage']['calls'], 0)
+
+    def test_explicit_snapshot_requires_model_and_endpoint_match(self):
+        adapter, _ = self.adapter(window=None)
+        with tempfile.TemporaryDirectory() as folder:
+            base = {'model': 'fixture-model', 'source': 'explicit', 'context_length': 8000,
+                    'base_url': adapter.base_url}
+            for key, value in (('model', 'other'), ('base_url', 'https://other.invalid')):
+                saved = dict(base, **{key: value})
+                wrapped = writing_api.WritingRequestAdapter(adapter, record(window=None),
+                    'fixture-model', project=folder, settings={'skill_budget': saved})
+                result = wrapped.chat([{'role': 'user', 'content': '任务'}])
+                self.assertEqual(result['reason'], 'context_window_unknown')
+
+    def test_sse_rejection_and_known_stop_usage_keep_one_prepared_body(self):
+        for window, reason in ((None, 'context_window_unknown'), (2000, 'context_budget_exceeded')):
+            adapter, transport = self.adapter(window=window)
+            with patch.object(router.model_pool, 'http_stream') as http:
+                result = adapter.stream([{'role': 'user', 'content': '中' * 2000}],
+                    {'max_tokens': 100}, 'fixture-model', on_chunk=lambda text: None)
+            self.assertEqual(result['reason'], reason)
+            http.assert_not_called()
+            transport.assert_not_called()
+        adapter, transport = self.adapter()
+        messages = [{'role': 'user', 'content': '任务'}]
+        prepared = adapter.prepare_request(messages, {'max_tokens': 100}, 'fixture-model')
+        reply = {'ok': True, 'status': 200, 'data': {'choices': [{'message': {'content': 'ok'},
+            'finish_reason': 'stop'}], 'usage': {'prompt_tokens': 10, 'completion_tokens': 2}}}
+        def stream(url, payload, headers, timeout, on_chunk, cancelled=None):
+            on_chunk('ok')
+            return reply
+        chunks = []
+        with patch.object(router.model_pool, 'http_stream', side_effect=stream) as http:
+            result = adapter.stream(messages, model='fixture-model', prepared=prepared, on_chunk=chunks.append)
+        self.assertEqual(chunks, ['ok'])
+        self.assertEqual(result['response_meta']['finish_reason'], 'stop')
+        self.assertEqual(result['usage']['prompt_tokens'], 10)
+        self.assertEqual(http.call_args.args[1], prepared.payload)
+        transport.assert_not_called()
+
+    def test_anthropic_second_tool_turn_blocks_before_second_ledger_or_http(self):
+        adapter, transport = self.adapter('messages', 14000)
+        transport.return_value = {'ok': True, 'status': 200, 'data': {'content': [
+            {'type': 'tool_use', 'id': 'fixture', 'name': 'read_file', 'input': {'path': 'fixture.md'}}],
+            'stop_reason': 'tool_use'}}
