+"""开发工具：从可信分层登记表生成 architecture.md 的标记区域（零外部依赖）。
+
+在程序目录运行 ``python -B scripts/generate_layer_docs.py --check`` 只读检查，
+或 ``--write`` 刷新。职责契约保存在标记外，不由此工具重建。
+本脚本位于 scripts/，不属于 _scan.module_scan_files 的顶层产品登记范围。
+"""
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+# 只导入仓库内可信、无产品依赖的纯表；不执行文档内容。
+from tests.architecture._layers import LAYERS, LAYER_NAMES
+
+DOCUMENT = ROOT / "architecture.md"
+BEGIN = "<!-- layer-registry:begin -->"
+END = "<!-- layer-registry:end -->"
+
+
+def render(layers=None, names=None):
+    """层名、层号、模块名单与计数均直接投影 registry，顺序稳定。"""
+    layers = LAYERS if layers is None else layers
+    names = LAYER_NAMES if names is None else names
+    unknown = set(layers.values()) - set(names)
+    if unknown:
+        raise ValueError(f"未命名层号：{sorted(unknown)}")
+    lines = ["| 层 | 登记模块数 | 模块（完整登记名） |", "| --- | --- | --- |"]
+    for layer, label in sorted(names.items()):
+        modules = sorted(name for name, value in layers.items() if value == layer)
+        listing = "、".join(f"`{name}`" for name in modules) or "—"
+        lines.append(f"| {label} | {len(modules)} | {listing} |")
+    return "\n".join(lines) + "\n"
+
+
+def replace_region(text, generated):
+    """只替换一对唯一标记之间的内容，保留标记外字符及原始换行。"""
+    if text.count(BEGIN) != 1 or text.count(END) != 1:
+        raise ValueError("分层文档须有且仅有一对生成标记")
+    start = text.index(BEGIN) + len(BEGIN)
+    stop = text.index(END)
+    if stop < start:
+        raise ValueError("分层文档生成标记顺序错误")
+    newline = "\r\n" if text[start:].startswith("\r\n") else "\n"
+    return text[:start] + newline + generated.replace("\n", newline) + text[stop:]
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--check", action="store_true", help="只读检查，过时返回 1")
+    mode.add_argument("--write", action="store_true", help="仅刷新标记内分层表")
+    parser.add_argument("--document", type=Path, default=DOCUMENT, help="目标文档（须有标记）")
+    args = parser.parse_args(argv)
+    original = args.document.read_bytes()
+    try:
+        updated = replace_region(original.decode("utf-8"), render()).encode("utf-8")
+    except ValueError as error:
+        print(error)
+        return 1
+    if updated == original:
+        print("分层文档已同步")
+        return 0
+    if args.check:
+        print("分层文档已过时；运行 scripts/generate_layer_docs.py --write")
+        return 1
+    args.document.write_bytes(updated)
+    print("已刷新分层文档生成区域")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
