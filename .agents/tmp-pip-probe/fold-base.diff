+"""C2：真实阶段与 CLI 入口在长任务副作用之前拒绝低／未知输出盘。"""
+import tempfile
+import unittest
+from contextlib import ExitStack
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from contract import stage_path_service
+from infra import storage_maintenance as storage
+from orchestrator import stage_handler_registry as registry
+from orchestrator import workflow_engines as engines
+
+
+class StageDiskGateTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.host = SimpleNamespace(root=self.root, pet=SimpleNamespace(_emit=Mock(), broadcast=Mock()))
+        self.stack = ExitStack()
+        self.addCleanup(self.stack.close)
+        def run_action(host, stage, trigger, **options):
+            if 'error' in options:
+                return host.pet._emit('stage.failed', stage=stage, error=options['error'])
+            return None
+        self.run_action = Mock(side_effect=run_action)
+        self.stack.enter_context(patch.object(registry, '_workflow_lock_error', return_value=''))
+        self.stack.enter_context(patch.object(registry.stage_flow, 'unchecked', return_value=False))
+        self.usage = self.stack.enter_context(patch.object(storage.shutil, 'disk_usage',
+                                                         return_value=SimpleNamespace(free=1024)))
+
+    def start(self, *args, **kwargs):
+        return registry.start(*args, run_action=self.run_action, **kwargs)
+
+    def test_stage_low_space_stops_real_storyboard_and_fallback(self):
+        for stage in ('storyboard', 'assets'):
+            with self.subTest(stage=stage), patch.object(registry, '_start_storyboard') as handler:
+                fallback = Mock()
+                text = self.start(self.host, stage, 'auto', fallback=fallback)
+                self.assertIn('当前剩余', text)
+                self.assertIn('所需', text)
+                self.assertIn('释放空间', text)
+                handler.assert_not_called()
+                fallback.assert_not_called()
+        self.assertEqual(self.host.pet._emit.call_count, 2)
+        errors = [call for call in self.run_action.call_args_list if 'error' in call.kwargs]
+        self.assertEqual(len(errors), 2)
+        self.host.pet.broadcast.assert_not_called()
+
+    def test_manual_rejection_has_visible_message_and_uses_existing_stage_target(self):
+        output = stage_path_service.write_dir(self.root, 'keyframe')
+        output.mkdir(parents=True)
+        fallback = Mock()
+        text = self.start(self.host, 'keyframe', 'manual', fallback=fallback)
+        self.assertIn('所需', text)
