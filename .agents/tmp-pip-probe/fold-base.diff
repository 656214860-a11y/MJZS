index 00000000..0a6c330c
--- /dev/null
+++ "b/\347\250\213\345\272\217/tests/test_model_router_context_overflow.py"
@@ -0,0 +1,203 @@
+# -*- coding: utf-8 -*-
+"""A1 V2：超限识别；估算仅观测，明确服务端上限才可收紧已有显式值。"""
+import copy
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from infra import model_pool, model_router, token_saver
+
+
+class ContextOverflowTests(unittest.TestCase):
+    def setUp(self):
+        self.runtime = patch.object(model_router, '_CONTEXT_PROBES', {}, create=True)
+        self.runtime.start()
+        self.addCleanup(self.runtime.stop)
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.record = {'model': 'a1-test-model', 'base_url': 'https://a1.invalid/v1',
+                       'wire_api': 'chat', 'path': '/chat/completions', 'context_length': 128000}
+        self.messages = [{'role': 'user', 'content': 'a' * 195000}]
+
+    def adapter(self, record=None, transport=None):
+        return model_router.PoolAdapter(record if record is not None else self.record,
+                                        program=self.temp.name, transport=transport, key='test-only')
+
+    def test_provider_wordings_precede_protocol_auth_and_400(self):
+        for wording in ('context_length_exceeded', 'maximum context length',
+                        'context length exceeded', 'prompt is too long', 'too many tokens',
+                        'reduce the length', '超出上下文', '上下文过长', '超过最大长度',
+                        'maximum context length 164031 tokens'):
+            with self.subTest(wording=wording):
+                self.assertEqual(model_router.error_class('HTTP 400 /chat/completions: ' + wording),
+                                 'context_overflow')
+
+    def test_plain_400_and_invalid_token_errors_use_shared_protocol_classification(self):
+        self.assertEqual(model_router.error_class('HTTP 400: invalid token parameter'), 'protocol')
+        self.assertEqual(model_router.error_class('invalid access token'), 'protocol')
+
+    def test_overflow_keeps_priority_when_http_status_is_present(self):
+        for status in (400, 401, 403, 429, 500):
+            with self.subTest(status=status):
+                self.assertEqual(model_router.error_class(
+                    'maximum context length is 164031 tokens', status=status), 'context_overflow')
+
+    def test_other_failures_use_the_shared_classifier_with_status(self):
+        from contract import error_codes
+        with patch.object(error_codes, 'classify', return_value=error_codes.lookup('E-NET-TIMEOUT')) as classify:
+            self.assertEqual(model_router.error_class('opaque failure', status=503), 'timeout')
+            classify.assert_called_once_with('opaque failure', status=503)
+
+    def test_status_only_authentication_does_not_create_context_probe(self):
+        adapter = self.adapter(transport=lambda *_: {'ok': False, 'status': 401, 'error': '', 'data': None})
+        result = adapter.chat([], model=self.record['model'])
+        self.assertEqual(result['error_class'], 'authentication')
+        self.assertNotIn('context_probe', adapter.record)
+
+    def test_failure_policy_never_retries_overflow_and_gives_action(self):
+        for status in (0, 400, 429, 500):
+            policy = model_router.failure_policy({'ok': False, 'status': status,
+                                                 'error': 'prompt is too long'})
+            self.assertFalse(policy['retryable'])
+            self.assertEqual(policy['reason_code'], 'context_overflow')
+            for word in ('缩短', '拆分', '模型'):
+                self.assertIn(word, policy['advice'])
+
+    def test_estimated_65k_failure_only_records_probe_and_never_blocks_next_send(self):
+        calls = []
+        def reject(*args):
+            calls.append(args)
+            return {'ok': False, 'status': 400, 'error': 'context_length_exceeded'}
+        original = copy.deepcopy(self.record)
+        adapter = self.adapter(transport=reject)
+        expected = token_saver.request_tokens(adapter.payload(self.record['model'], self.messages,
+                                                               {'max_tokens': 16}, ''))
+        with patch.object(model_pool, 'store', side_effect=AssertionError('不得持久化')):
+            failed = adapter.chat(self.messages, options={'max_tokens': 16}, model=self.record['model'])
+            self.assertEqual(failed['error_class'], 'context_overflow')
+            self.assertIn('请核实窗口', failed['error'])
+            self.assertIn(str(expected), failed['error'])
+            probe = adapter.record['context_probe']
+            self.assertEqual(probe['estimated_tokens'], expected)
+            self.assertGreaterEqual(probe['estimated_tokens'], 65000)
+            self.assertEqual(probe['model'], self.record['model'])
+            self.assertGreater(probe['time'], 0)
+            self.assertIn('context_length_exceeded', probe['server_summary'])
+            self.assertEqual(adapter.record['context_length'], 128000)
+            adapter.chat(self.messages, options={'max_tokens': 16}, model=self.record['model'])
+            another = self.adapter(transport=reject)
+            another.chat(self.messages, options={'max_tokens': 16}, model=self.record['model'])
+        self.assertEqual(len(calls), 3)
+        self.assertEqual(self.record, original)
+
+    def test_unknown_config_stays_unknown_even_when_server_declares_limit(self):
+        from unittest.mock import Mock
+        transport = Mock()
+        adapter = self.adapter(dict(self.record, context_length=''), transport=transport)
+        # A3/A4拒发未知窗口；A1直接在真实服务端观测处理边界验证不能回填。
+        payload = adapter.payload(self.record['model'], self.messages)
+        for _ in range(2):
+            result = adapter._context_failure({'ok': False, 'status': 400,
+                'error': 'maximum context length is 60000 tokens'}, self.record['model'], payload)
+            self.assertEqual(result['status'], 400)
+            self.assertEqual(adapter.record['context_length'], '')
+        self.assertIn('context_probe', adapter.record)
+        rejected = adapter.chat(self.messages, model=self.record['model'])
+        self.assertEqual(rejected['reason'], 'context_window_unknown')
+        transport.assert_not_called()
+
+    def test_explicit_smaller_server_max_lowers_only_process_copy_and_logs(self):
+        adapter = self.adapter(transport=lambda *_: {'ok': False, 'status': 400,
+            'error': 'maximum context length is 60000 tokens; requested 65000 tokens'})
+        with self.assertLogs('infra.model_router', level='INFO') as logs:
+            adapter.chat(self.messages, model=self.record['model'])
+        self.assertEqual(adapter.record['context_length'], 60000)
+        self.assertEqual(self.record['context_length'], 128000)
+        self.assertIn('128000', ' '.join(logs.output))
+        self.assertIn('60000', ' '.join(logs.output))
+        blocked = adapter.chat(self.messages, model=self.record['model'])
+        self.assertEqual(blocked['reason'], 'context_budget_exceeded')
+
+    def test_estimate_and_requested_count_are_not_declared_server_max(self):
+        for error in ('too many tokens: requested 65000', 'context_length_exceeded 65000',
+                      'maximum context length exceeded; requested 65000 tokens'):
+            with self.subTest(error=error):
+                adapter = self.adapter(transport=lambda *_, message=error: {
+                    'ok': False, 'status': 400, 'error': message})
+                adapter.chat(self.messages, model=self.record['model'])
+                self.assertEqual(adapter.record['context_length'], 128000)
+
+    def test_larger_server_limit_never_raises_explicit_window(self):
+        adapter = self.adapter(dict(self.record, context_length=80000), transport=lambda *_: {
+            'ok': False, 'status': 400, 'error': 'maximum context length is 100000 tokens'})
+        adapter.chat(self.messages, model=self.record['model'])
+        self.assertEqual(adapter.record['context_length'], 80000)
+
+    def test_probe_redacts_secrets_and_does_not_copy_request_body(self):
+        secret = 'sk-' + 'A' * 24
+        adapter = self.adapter(transport=lambda *_: {'ok': False, 'status': 400,
+            'error': 'too many tokens Authorization: Bearer SYNTHETIC-SECRET api_key=' + secret})
+        adapter.chat(self.messages, model=self.record['model'])
+        summary = str(adapter.record['context_probe'])
+        self.assertNotIn(secret, summary)
+        self.assertNotIn('SYNTHETIC-SECRET', summary)
+        self.assertNotIn('a' * 100, summary)
+        self.assertLessEqual(len(adapter.record['context_probe']['server_summary']), 300)
+
+    def test_probes_are_endpoint_isolated_bounded_and_never_authoritative(self):
+        for index in range(130):
+            adapter = self.adapter(dict(self.record, base_url='https://a%d.invalid/v1' % index),
+                                   transport=lambda *_: {'ok': False, 'status': 400,
+                                                         'error': 'too many tokens'})
+            adapter.chat([], model=self.record['model'])
+        self.assertEqual(len(model_router._CONTEXT_PROBES), 128)
+        self.assertIn('context_probe', adapter.record)
+        self.assertEqual(adapter.record['context_length'], 128000)
+        keys = list(model_router._CONTEXT_PROBES)
+        self.assertNotEqual(keys[0], keys[1])
+
+    def test_stream_records_probe_without_fallback_or_automatic_estimate_gate(self):
+        adapter = self.adapter(transport=lambda *_: self.fail('超限不得回退到 chat'))
+        with patch.object(model_pool, 'http_stream', return_value={
+                'ok': False, 'status': 400, 'error': 'HTTP 400: prompt is too long'}) as stream:
+            for _ in range(2):
+                failed = adapter.stream(self.messages, options={'max_tokens': 16},
+                                        model=self.record['model'], on_chunk=lambda _: None)
+                self.assertEqual(failed['error_class'], 'context_overflow')
+                self.assertFalse(failed['failure']['retryable'])
+            self.assertEqual(stream.call_count, 2)
+            self.assertEqual(adapter.record['context_length'], 128000)
+            self.assertIn('context_probe', adapter.record)
+
