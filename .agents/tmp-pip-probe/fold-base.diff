+def _one_stage_declaration(tree: ast.Module, name: str) -> ast.AST:
+    declarations = [node for node in ast.walk(tree)
+                    if isinstance(node, (ast.Name, ast.Attribute))
+                    and isinstance(node.ctx, (ast.Store, ast.Del))
+                    and (node.id if isinstance(node, ast.Name) else node.attr) == name]
+    values = [node.value for node in tree.body if isinstance(node, ast.Assign)
+              and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)
+              and node.targets[0].id == name]
+    if len(declarations) != 1 or len(values) != 1:
+        raise ValueError(f'{name}: expected one top-level declaration')
+    return values[0]
+
+
+def _literal_stage_record(node: ast.AST) -> tuple[str, str]:
+    fields = ('directory', 'stage', 'name', 'description', 'inputs', 'outputs',
+              'longtask', 'needs_output_disk', 'dependencies')
+    if (not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name)
+            or node.func.id != 'StageDefinition' or len(node.args) > len(fields)
+            or any(isinstance(arg, ast.Starred) for arg in node.args)):
+        raise ValueError('STAGE_DEFINITIONS: expected StageDefinition literal records')
+    values = dict(zip(fields, node.args))
+    for keyword in node.keywords:
+        if keyword.arg not in fields or keyword.arg in values:
+            raise ValueError('STAGE_DEFINITIONS: unknown or duplicate record field')
+        values[keyword.arg] = keyword.value
+    if not set(fields[:6]) <= values.keys():
+        raise ValueError('STAGE_DEFINITIONS: incomplete record')
+    try:
+        literal = {key: ast.literal_eval(value) for key, value in values.items()}
+    except (ValueError, TypeError, SyntaxError) as error:
+        raise ValueError('STAGE_DEFINITIONS: nonliteral record field') from error
+    if (any(not isinstance(literal[key], str) or not literal[key].strip() for key in fields[:4])
+            or any(not isinstance(literal[key], tuple)
+                   or not all(isinstance(item, str) for item in literal[key]) for key in fields[4:6])
+            or any(key in literal and type(literal[key]) is not bool for key in fields[6:8])
