@@ -0,0 +1,348 @@
+"""C4 global 真实入口行为：临时目录、显式路径与发布器，无用户配置。"""
+import json
+import tempfile
+import threading
+import unittest
+from contextlib import contextmanager
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+from infra import model_pool, pet_llm
+from infra.config_validation import ConfigValidationError
+
+
+class ConfigGlobalValidationTests(unittest.TestCase):
+    def setUp(self):
+        self.folder = tempfile.TemporaryDirectory()
+        self.addCleanup(self.folder.cleanup)
+        self.program = Path(self.folder.name)
+        self.path = model_pool.config_file(self.program)
+        self.path.parent.mkdir(parents=True)
+        self.lock = threading.RLock()
+        self.local = threading.local()
+        self.saves = []
+        self.snapshots = []
+
+    def reader(self, path):
+        return json.loads(Path(path).read_text(encoding='utf-8'))
+
+    @contextmanager
+    def access(self):
+        with self.lock:
+            self.local.locked = True
+            try:
+                yield
+            finally:
+                self.local.locked = False
+
+    def publisher(self, path, data):
+        self.assertTrue(self.local.locked)
+        self.saves.append(data)
+        Path(path).write_text(json.dumps(data), encoding='utf-8')
+
+    def snapshot(self, *args):
+        self.assertTrue(self.local.locked)
+        self.snapshots.append(args)
+
+    def store(self, data):
+        return model_pool.store(data, self.program, reader=self.reader,
+                                publisher=self.publisher, access=self.access,
+                                snapshot=self.snapshot)
+
+    def update(self, mutate):
+        return model_pool._update(mutate, self.program, reader=self.reader,
+                                  publisher=self.publisher, access=self.access,
+                                  snapshot=self.snapshot)
+
+    def write(self, data):
+        self.path.write_text(json.dumps(data), encoding='utf-8')
+
+    def test_both_global_reads_share_strict_validation(self):
+        invalid = [{'timeout': True}, {'timeout': '60'}, {'off_peak': [24, 7]},
+                   {'models': []}, {'models': {'x': {'label': 7}}},
+                   {'agent': {'models': {'chat': False}}}, {'budget': {'tokens_per_day': True}},
+                   {'fallback': {'model': 3}}, {'force_tier': False},
+                   {'models': {'x': {'context_length': True}}},
+                   {'models': {'x': {'cost': False}}},
+                   {'agent': {'name': []}}]
+        for config in invalid:
+            with self.subTest(config=config):
+                self.write(config)
+                for load in (model_pool.raw, pet_llm.load_config):
+                    with self.assertRaises(ConfigValidationError):
+                        load(self.program, reader=self.reader)
+                    with self.assertRaises(ConfigValidationError):
+                        load(self.program, config=config)
+
+    def test_read_legacy_missing_and_absent_models_without_write(self):
+        for existing in (False, True):
+            if existing:
+                self.write({'unknown': {'nested': [1, {'x': 'keep'}]}})
+            before = self.path.read_bytes() if existing else None
+            raw = model_pool.raw(self.program, reader=self.reader)
+            view = pet_llm.load_config(self.program, reader=self.reader)
+            self.assertNotIn('models', raw)
+            self.assertEqual(view['config_schema_version'], 1)
+            self.assertEqual(set(view), set(pet_llm.DEFAULTS) | {'config_schema_version'})
+            self.assertEqual(view['timeout'], pet_llm.DEFAULTS['timeout'])
+            self.assertEqual(model_pool.pool(config=raw), model_pool.default_pool())
+            self.assertEqual(self.path.read_bytes() if self.path.exists() else None, before)
+        self.assertEqual(model_pool.raw(self.program, config={'models': {}})['models'], {})
+        self.assertEqual(set(model_pool.pool(config={'models': {}})), set(model_pool.DESKTOP_ENGINES))
+
+    def test_store_and_update_refuse_bad_original_before_snapshot(self):
+        for raw in (b'{"secret":"SENTINEL",', b'[]', b'null',
+                    b'{"config_schema_version":true}', b'{"config_schema_version":2}'):
+            for operation in (lambda: self.store({'timeout': 60}),
+                              lambda: self.update(lambda data: {'timeout': 60})):
+                with self.subTest(raw=raw):
+                    self.path.write_bytes(raw)
+                    for load in (model_pool.raw, pet_llm.load_config):
+                        with self.assertRaises(ConfigValidationError):
+                            load(self.program, reader=self.reader)
+                    with self.assertRaises(ConfigValidationError) as caught:
+                        operation()
+                    self.assertNotIn('SENTINEL', str(caught.exception))
+                    self.assertEqual(self.path.read_bytes(), raw)
+        self.assertEqual(self.saves, [])
+        self.assertEqual(self.snapshots, [])
+
+    def test_permission_and_invalid_candidate_never_publish(self):
+        self.write({'unknown': 'keep'})
+        before = self.path.read_bytes()
+        with patch.object(self, 'reader', side_effect=PermissionError('SENTINEL')):
+            for operation in (lambda: self.store({}), lambda: self.update(lambda data: data)):
+                with self.assertRaises(ConfigValidationError) as caught:
+                    operation()
+                self.assertNotIn('SENTINEL', str(caught.exception))
+        with self.assertRaises(ConfigValidationError):
+            self.store({'timeout': False})
+        with self.assertRaises(ConfigValidationError):
+            self.update(lambda data: {'models': []})
+        self.assertEqual(self.path.read_bytes(), before)
+        self.assertEqual(self.saves, [])
+        self.assertEqual(self.snapshots, [])
+
+    def test_missing_file_is_the_only_create_case_and_read_occurs_under_lock(self):
+        reads = []
+        def locked_reader(path):
+            self.assertTrue(self.local.locked)
+            reads.append(path)
+            return self.reader(path)
+        model_pool.store({'unknown': {'x': 1}}, self.program, reader=locked_reader,
+                         publisher=self.publisher, access=self.access, snapshot=self.snapshot)
+        self.assertEqual(reads, [self.path])
+        self.assertEqual(self.reader(self.path)['unknown'], {'x': 1})
+        self.assertEqual(len(self.saves), 1)
+        self.assertEqual(len(self.snapshots), 1)
+        self.assertEqual(self.reader(self.path)['config_schema_version'], 1)
+        before = self.path.read_bytes()
+        self.update(lambda data: None)
+        self.assertEqual(self.path.read_bytes(), before)
+        self.assertEqual(len(self.saves), 1)
+
+    def test_normal_save_and_noop_upgrade_preserve_nested_unknown(self):
+        legacy = {'unknown': {'deep': [{'private': 'keep'}]},
+                  'models': {'x': {'label': 'x', 'future': {'a': [1, 2]}}},
+                  'agent': {'models': {'chat': 'x'}, 'extra': {'x': 3}}}
+        self.write(legacy)
+        loaded = model_pool.raw(self.program, reader=self.reader)
+        self.store(loaded)
+        saved = self.reader(self.path)
+        self.assertEqual(saved['config_schema_version'], 1)
+        for key in legacy:
+            self.assertEqual(saved[key], legacy[key])
+        self.assertEqual(len(self.saves), 1)
+        self.assertEqual(len(self.snapshots), 1)
+        self.write(legacy)
+        self.update(lambda data: data)
+        self.assertEqual(self.reader(self.path)['config_schema_version'], 1)
+        self.assertEqual(len(self.saves), 2)
+
+    def test_update_reloads_inside_lock_and_retains_other_fields(self):
+        self.write({'counter': 0, 'other': {'deep': 'keep'}})
+        errors = []
+        def worker():
+            try:
+                for _ in range(8):
+                    self.update(lambda data: dict(data, counter=data['counter'] + 1))
+            except Exception as exc:
+                errors.append(exc)
+        workers = [threading.Thread(target=worker) for _ in range(3)]
+        for worker_thread in workers:
+            worker_thread.start()
+        for worker_thread in workers:
+            worker_thread.join(10)
+            self.assertFalse(worker_thread.is_alive())
+        self.assertEqual(errors, [])
+        saved = self.reader(self.path)
+        self.assertEqual(saved['counter'], 24)
+        self.assertEqual(saved['other'], {'deep': 'keep'})
+
+    def test_store_none_is_rejected_without_false_saved_path(self):
+        self.write({'unknown': 'keep'})
+        before = self.path.read_bytes()
+        with self.assertRaises(ConfigValidationError):
+            self.store(None)
+        self.assertEqual(self.path.read_bytes(), before)
+        self.assertEqual(self.saves, [])
+        self.assertEqual(self.snapshots, [])
+
+    def test_production_update_uses_strict_reader_despite_same_stat_cache(self):
+        import os
+        from infra import file_cache
+        self.write({'outside': 'before', 'counter': 0})
+        model_pool.raw(self.program)
+        before_stat = self.path.stat()
+        raw = self.path.read_bytes()
+        changed = raw.replace(b'before', b'after!')
+        self.assertEqual(len(raw), len(changed))
+        self.path.write_bytes(changed)
+        os.utime(self.path, ns=(before_stat.st_atime_ns, before_stat.st_mtime_ns))
+        model_pool._update(lambda data: dict(data, counter=data['counter'] + 1), self.program,
+                           publisher=self.publisher, snapshot=self.snapshot, access=self.access)
+        self.assertEqual(self.saves[-1]['outside'], 'after!')
+        self.assertEqual(self.saves[-1]['counter'], 1)
+        self.path.write_bytes(raw)
+        file_cache.invalidate(self.path)
+        model_pool.raw(self.program)
+        stamp = self.path.stat()
+        invalid = b'[' + b' ' * (len(raw) - 2) + b']'
+        self.path.write_bytes(invalid)
+        os.utime(self.path, ns=(stamp.st_atime_ns, stamp.st_mtime_ns))
+        saves, snapshots = len(self.saves), len(self.snapshots)
+        with self.assertRaises(ConfigValidationError):
