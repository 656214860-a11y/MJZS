+class DpiWatchState:
+    """仅观察显式登记顶层；状态不强持有窗口，不扫描、不轮询。"""
+    def __init__(self, root, *, read_dpi, apply_dpi, refresh):
+        import weakref
+        self.root = weakref.ref(root)
+        self.tops = weakref.WeakKeyDictionary()
+        self.candidate = None
+        self.pending = None
+        self.generation = 0
+        self.closed = False
+        self.read_dpi, self.apply_dpi, self.refresh = read_dpi, apply_dpi, refresh
+        initial = float(root.tk.call('tk', 'scaling')) * 72
+        self.applied_dpi = initial if self._valid_dpi(initial) else None
+
+    @staticmethod
+    def _valid_dpi(value):
+        import math
+        return (not isinstance(value, bool) and isinstance(value, (int, float))
+                and math.isfinite(value) and value > 0)
+
+    def watch(self, top):
+        import weakref
+        if self.closed or top in self.tops:
+            return
+        window = weakref.ref(top)
+        configure = top.bind('<Configure>', lambda event: self._event(event, window), add='+')
+        destroy = top.bind('<Destroy>', lambda event: self._destroy(event, window), add='+')
+        self.tops[top] = (configure, destroy)
+
+    def _invalidate(self):
+        self.generation += 1
+        pending, self.pending = self.pending, None
+        self.candidate = None
+        root = self.root()
+        if pending is not None and root is not None:
+            try:
+                root.after_cancel(pending[0])
+            except tk.TclError:
+                pass
+
+    def unwatch(self, top):
+        identifiers = self.tops.pop(top, None)
+        if identifiers is None:
+            return
+        candidate = self.candidate() if self.candidate is not None else None
+        if top is self.root() or top is candidate:
+            self._invalidate()
+        for event, identifier in zip(('<Configure>', '<Destroy>'), identifiers):
+            if identifier:
+                top.unbind(event, identifier)
+
+    def _destroy(self, event, window):
+        top = window()
+        if self.closed or top is None or event.widget is not top:
+            return
+        if top is self.root():
+            self.closed = True
+            self._invalidate()
+            self.tops.clear()
+        else:
+            self.unwatch(top)
+
+    def _event(self, event, window):
+        top = window()
+        if self.closed or top is None or event.widget is not top or top not in self.tops:
+            return
+        self.candidate = window
+        if self.pending is None:
+            root = self.root()
+            if root is not None:
+                self.generation += 1
+                generation = self.generation
+                identifier = root.after_idle(lambda: self._run(generation))
+                self.pending = (identifier, generation)
+
+    def _run(self, generation):
+        if self.closed or self.pending is None or self.pending[1] != generation:
+            return
+        self.pending = None
+        root = self.root()
+        top = self.candidate() if self.candidate is not None else None
+        if root is None or top is None or top not in self.tops:
+            return
+        try:
+            if not root.winfo_exists() or not top.winfo_exists():
+                return
+            dpi = self.read_dpi(top)
+            import math
+            if not self._valid_dpi(dpi):
+                return
+            if self.applied_dpi is not None and math.isclose(dpi, self.applied_dpi, rel_tol=0, abs_tol=0.5):
+                return
+            self.apply_dpi(root, dpi=dpi)
+            self.applied_dpi = dpi
+            self.refresh(root)
+        except Exception:
+            self._invalidate()
+            import logging
+            logging.getLogger(__name__).exception('顶层DPI刷新失败；等待下一次有效窗口事件')
