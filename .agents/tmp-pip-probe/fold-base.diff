+"""C4 配置核心行为；仅合成数据，不读取用户配置或导入 Tk。"""
+import copy
+import logging
+import io
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+from infra.config_validation import CURRENT_CONFIG_SCHEMA_VERSION, ConfigValidationError, read_config, validate
+
+
+class ConfigValidationTests(unittest.TestCase):
+    def reject(self, kind, data):
+        with self.assertRaises(ConfigValidationError) as caught:
+            validate(kind, data)
+        return caught.exception
+
+    def test_root_must_be_object(self):
+        for kind in ('global', 'project', 'profile'):
+            for value in (None, [], 'secret', 1, True):
+                with self.subTest(kind=kind, value=type(value).__name__):
+                    self.reject(kind, value)
+
+    def test_unknown_kind_is_safe(self):
+        with self.assertRaises(ConfigValidationError) as caught:
+            validate('api_key=SENTINEL', {})
+        self.assertNotIn('SENTINEL', str(caught.exception))
+
+    def test_project_defaults_strict_and_independent(self):
+        result = validate('project', {})
+        expected = ('review', 'adopt', 'edit', 'submit', 'keyframe', 'asset', 'video', 'previs', 'final', 'handoff')
+        for name in expected:
+            self.assertIs(result['auto_' + name], False)
+            for value in ('false', 0, 1, None):
+                self.reject('project', {'auto_' + name: value})
+        self.assertIs(validate('project', {'auto_edit': True})['auto_edit'], True)
+
+    def test_defaults_match_global_source(self):
+        result = validate('global', {})
+        self.assertEqual(result['timeout'], 60)
+        self.assertEqual(result['off_peak'], [23, 7])
+        self.assertEqual(result['budget']['tokens_per_day'], 2000000)
+        self.assertEqual(result['flash_model'], 'deepseek-v4-flash')
+        self.assertEqual(result['max_tokens'], {})
+        self.assertEqual(result['fallback'], {})
+        self.assertNotIn('models', result)
+        self.assertEqual(validate('global', {'models': {}})['models'], {})
+
+    def test_strict_global_values_and_nested_fields(self):
+        for field, values in {'timeout': (0, -1, True, '60', 1.5), 'base_url': (None, 1),
+                              'off_peak': ([0], [0, 1, 2], [-1, 2], [0, 24], [True, 2], ['1', 2]),
+                              'max_tokens': ({'flash': 0}, {'pro': True}),
+                              'budget': ({'tokens_per_day': 0}, {'tokens_per_day': '2'}),
+                              'models': ([], {'m': {'label': 1}}),
+                              'agent': ({'models': {'chat': False}},),
+                              'deleted_desktop_models': ('m', [1])}.items():
+            for value in values:
+                with self.subTest(field=field, value=value):
+                    self.reject('global', {field: value})
+        self.assertEqual(validate('global', {'off_peak': [0, 23]})['off_peak'], [0, 23])
+
+    def test_unknown_deep_fields_preserved_and_input_not_mutated(self):
+        data = {'models': {'m': {'model': 'm', 'private': {'api_key': ['SENTINEL']}}},
+                'budget': {'private': {'x': 1}}, 'private': {'list': [1, {'x': 2}]}}
+        original = copy.deepcopy(data)
+        result = validate('global', data)
+        self.assertEqual(data, original)
+        self.assertEqual(result['models']['m']['private'], data['models']['m']['private'])
+        result['private']['list'][1]['x'] = 9
+        result['models']['m']['private']['api_key'].append('changed')
+        self.assertEqual(data, original)
+
+    def test_versions_missing_current_future_and_invalid(self):
+        self.assertEqual(CURRENT_CONFIG_SCHEMA_VERSION, 1)
+        for kind in ('global', 'project', 'profile'):
+            self.assertEqual(validate(kind, {})['config_schema_version'], 1)
+            self.assertEqual(validate(kind, {'config_schema_version': 1})['config_schema_version'], 1)
+            for version in (0, -1, 2, '1', True, None):
+                self.reject(kind, {'config_schema_version': version})
+
+    def test_profile_fields_legacy_lists_and_old_schema_independent(self):
+        result = validate('profile', {'schema_version': 1, 'profiles': [{'id': 'client',
+            'aliases': 'alias', 'invoke': 'client', 'process_names': 'client.exe',
+            'detect': {'exe_names': 'client.exe', 'store_packages': [{'package': 'pkg', 'private': 1}]},
+            'window': {'titles': 'Client', 'private': True}, 'private': {'a': 1}}]})
+        self.assertEqual(result['schema_version'], 1)
+        self.assertEqual(result['config_schema_version'], 1)
+        row = result['profiles'][0]
+        self.assertEqual(row['aliases'], ['alias'])
+        self.assertEqual(row['invoke'], ['client'])
+        self.assertEqual(row['detect']['exe_names'], ['client.exe'])
+        self.assertEqual(row['detect']['store_packages'][0]['private'], 1)
+        self.assertTrue(row['window']['private'])
+        self.assertEqual(validate('profile', {})['profiles'], [])
+        for row in ({}, {'id': ''}, {'id': '  '}, {'id': 1}, {'id': 'a', 'display': 1},
+                    {'id': 'a', 'aliases': [1]}, {'id': 'a', 'detect': {'exe_names': 1}},
+                    {'id': 'a', 'detect': {'store_packages': [{'package': 1}]}},
+                    {'id': 'a', 'invoke': [1]}):
+            self.reject('profile', {'profiles': [row]})
+
+    def test_fallback_responses_path_is_a_strict_string(self):
+        self.assertEqual(validate('global', {'fallback': {'responses_path': '/responses'}})
+                         ['fallback']['responses_path'], '/responses')
+        for value in (None, 7, True, []):
+            with self.subTest(value=value):
+                self.reject('global', {'fallback': {'wire_api': 'responses', 'responses_path': value}})
+
