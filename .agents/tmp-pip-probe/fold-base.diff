+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+
+from infra import client_profiles as profiles, project_settings as project
+from infra.config_validation import ConfigValidationError, validate
+
+
+class ConfigProjectProfileValidationTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.builtin = self.root / 'builtin.json'
+        self.user = self.root / 'user.json'
+        self.settings = project.file(self.root)
+        self.write(self.builtin, {'profiles': []})
+        self.write(self.user, {'profiles': []})
+        self.addCleanup(profiles.clear_cache)
+        profiles.clear_cache()
+        for name, value in (('BUILTIN_FILE', self.builtin), ('USER_FILE', self.user), ('PROGRAM', self.root)):
+            ctx = patch.object(profiles, name, value)
+            ctx.start()
+            self.addCleanup(ctx.stop)
+
+    def write(self, path, data):
+        path.write_text(json.dumps(data), encoding='utf-8')
+
+    def test_project_legacy_read_no_io_write_and_same_value_upgrade(self):
+        self.write(self.settings, {'auto_review': True, 'unknown': {'deep': [1, {'x': 2}]}})
+        before = self.settings.read_bytes()
+        with patch.object(project, 'save', wraps=project.save) as save:
+            loaded = project.load(self.root)
+            direct = project.read_prefs(self.settings)
+            self.assertEqual(loaded['config_schema_version'], 1)
+            self.assertEqual(direct['config_schema_version'], 1)
+            self.assertEqual(before, self.settings.read_bytes())
+            save.assert_not_called()
+            self.assertTrue(project.put(self.root, 'auto_review', True))
+            save.assert_called_once()
+        persisted = json.loads(self.settings.read_bytes())
+        self.assertEqual(persisted['config_schema_version'], 1)
+        self.assertEqual(persisted['unknown'], {'deep': [1, {'x': 2}]})
+
+    def test_project_versions_and_bool_reject_write_keep_bytes_and_safeoff(self):
+        cases = [{'config_schema_version': value} for value in (2, True, 0, '1', None)]
+        cases += [{'auto_review': value} for value in (1, 0, 'false', None)]
+        for data in cases:
+            with self.subTest(data=data):
+                self.write(self.settings, data)
+                before = self.settings.read_bytes()
+                with patch.object(project, 'save') as save:
+                    with self.assertRaises(ValueError):
+                        project.read_prefs(self.settings)
+                    self.assertEqual(project.load(self.root), {})
+                    with self.assertRaises(ValueError):
+                        project.put(self.root, 'auto_review', True)
+                    save.assert_not_called()
+                self.assertEqual(self.settings.read_bytes(), before)
+
+    def test_project_reader_injection_is_preserved_and_safe(self):
+        source = {'unknown': {'deep': [1]}}
+        with patch.object(project, 'save') as save:
+            result = project.read_prefs(self.settings, reader=lambda path: source)
+            self.assertEqual(result['config_schema_version'], 1)
+            result['unknown']['deep'].append(2)
+            self.assertEqual(source, {'unknown': {'deep': [1]}})
+            save.assert_not_called()
+        def denied(path):
+            raise PermissionError('SECRET_SENTINEL')
+        with self.assertRaises(ValueError) as caught:
+            project.read_prefs(self.settings, reader=denied)
+        self.assertNotIn('SECRET_SENTINEL', str(caught.exception))
+
+    def test_profile_separate_documents_cannot_mask_invalid_builtin_or_user(self):
+        for bad in (self.builtin, self.user):
+            for data in ({'profiles': [{'id': 3}]}, {'config_schema_version': 2}, {'profiles': [{'id': 'x', 'aliases': [False]}]}):
+                with self.subTest(file=bad.name, data=data):
+                    self.write(self.builtin, {'profiles': [{'id': 'builtin'}]})
+                    self.write(self.user, {'profiles': [{'id': 'user'}]})
+                    self.write(bad, data)
+                    with self.assertRaises(ConfigValidationError):
+                        profiles.load_profiles(refresh=True)
+
+    def test_profile_bad_user_refuses_save_without_bytes_change(self):
+        for raw in (b'{"secret":"SECRET_SENTINEL",', b'[]', b'null', b'\xff', b'{"config_schema_version":2}', b'{"profiles":[{"id":1}]}'):
+            with self.subTest(raw=raw):
+                self.user.write_bytes(raw)
+                with patch.object(profiles, 'save') as save:
+                    with self.assertRaises(ValueError) as caught:
+                        profiles.save_user_profile({'id': 'new'})
+                    save.assert_not_called()
+                self.assertNotIn('SECRET_SENTINEL', str(caught.exception))
+                self.assertEqual(self.user.read_bytes(), raw)
+
+    def test_profile_permission_rejected_and_strict_versions(self):
+        original = self.user.read_bytes()
+        with patch.object(profiles, 'read', side_effect=PermissionError('SECRET_SENTINEL')), patch.object(profiles, 'save') as save:
+            with self.assertRaises(ConfigValidationError) as caught:
+                profiles.save_user_profile({'id': 'new'})
+            save.assert_not_called()
+        self.assertNotIn('SECRET_SENTINEL', str(caught.exception))
+        self.assertEqual(self.user.read_bytes(), original)
+        for version in (True, 0, '1', None):
+            self.write(self.user, {'config_schema_version': version})
+            original = self.user.read_bytes()
+            with patch.object(profiles, 'save') as save:
+                with self.assertRaises(ConfigValidationError):
+                    profiles.save_user_profile({'id': 'new'})
+                save.assert_not_called()
+            self.assertEqual(self.user.read_bytes(), original)
+
+    def test_profile_unknowns_update_preserved_and_cache_refreshes(self):
+        row = {'id': 'custom', 'aliases': ['Keep Alias'], 'display': 'Before', 'extension': {'secret': [1]},
+               'detect': {'exe_names': 'demo.exe', 'private': {'x': [1]}}, 'window': {'private': True}}
+        original = {'schema_version': 1, 'root_extra': {'deep': [1]}, 'profiles': [row, {'id': 'other', 'extra': [3]}]}
+        self.write(self.user, original)
+        before = self.user.read_bytes()
+        self.assertEqual(profiles.load_profiles()['custom']['display'], 'Before')
+        self.assertEqual(self.user.read_bytes(), before)
+        profiles.save_user_profile({'id': 'custom', 'display': 'After', 'detect': {'known_dirs': ['new']}})
+        persisted = json.loads(self.user.read_bytes())
+        self.assertEqual(persisted['schema_version'], 1)
+        self.assertEqual(persisted['config_schema_version'], 1)
+        self.assertEqual(persisted['root_extra'], original['root_extra'])
+        saved = next(r for r in persisted['profiles'] if r['id'] == 'custom')
+        self.assertEqual(saved['aliases'], row['aliases'])
+        self.assertEqual(saved['extension'], row['extension'])
+        self.assertEqual(saved['detect']['private'], row['detect']['private'])
+        self.assertEqual(saved['detect']['exe_names'], ['demo.exe'])
+        self.assertEqual(saved['detect']['known_dirs'], ['new'])
+        self.assertEqual(saved['window']['private'], True)
+        self.assertEqual(profiles.load_profiles()['custom']['display'], 'After')
+
+    def test_profile_missing_creation_and_builtin_precedence(self):
+        self.user.unlink()
+        self.write(self.builtin, {'profiles': [{'id': 'shared', 'display': 'Builtin'}]})
+        profiles.save_user_profile({'id': 'shared', 'display': 'User'})
+        self.assertEqual(profiles.load_profiles()['shared']['display'], 'Builtin')
+        self.assertEqual(json.loads(self.user.read_bytes())['config_schema_version'], 1)
+
+    def test_profile_save_strict_read_validate_publish_share_lock(self):
+        held = []
+        class Lock:
+            def __enter__(self): held.append(True)
+            def __exit__(self, *args): held.pop()
+        real_read, real_save = profiles._read, profiles.save
+        def read(path):
+            self.assertEqual(held, [True])
+            return real_read(path)
+        def save(*args):
+            self.assertEqual(held, [True])
+            return real_save(*args)
+        with patch.object(profiles, 'access', return_value=Lock(), create=True), patch.object(profiles, '_read', side_effect=read), patch.object(profiles, 'save', side_effect=save):
+            profiles.save_user_profile({'id': 'new'})
+
+    def test_profile_concurrent_updates_keep_rows(self):
+        barrier = threading.Barrier(2)
+        errors = []
+        def worker(identifier):
+            try:
+                barrier.wait(timeout=5)
+                profiles.save_user_profile({'id': identifier})
+            except Exception as exc:
+                errors.append(type(exc).__name__)
+        threads = [threading.Thread(target=worker, args=(name,)) for name in ('one', 'two')]
+        for thread in threads: thread.start()
+        for thread in threads: thread.join(timeout=10)
+        self.assertFalse(any(thread.is_alive() for thread in threads))
+        self.assertEqual(errors, [])
+        self.assertEqual({r['id'] for r in json.loads(self.user.read_bytes())['profiles']}, {'one', 'two'})
+
+    def test_profile_omitted_fields_keep_existing_cli_inference(self):
+        self.write(self.user, {'profiles': [{'id': 'legacy-cli', 'invoke': '--prompt'}]})
+        row = profiles.load_profiles()['legacy-cli']
+        self.assertEqual(row['kind'], 'cli')
+        self.assertEqual(row['delivery'], 'cli_arg')
+        self.assertEqual(row['display'], 'legacy-cli')
+        profiles.save_user_profile({'id': 'legacy-cli', 'output': 'stdout'})
+        persisted = json.loads(self.user.read_bytes())['profiles'][0]
+        self.assertNotIn('kind', persisted)
+        self.assertNotIn('delivery', persisted)
+        self.assertEqual(profiles.load_profiles()['legacy-cli']['delivery'], 'cli_arg')
+
+    def test_profile_fields_strict_safe_errors_and_declared_legacy(self):
+        for row in ({}, {'id': ''}, {'id': False}, {'id': 'x', 'display': 1}, {'id': 'x', 'detect': {'exe_names': [False]}}, {'id': 'x', 'window': {'titles': 1}}):
+            with self.subTest(row=row):
+                with self.assertRaises(ConfigValidationError) as caught:
+                    validate('profile', {'profiles': [dict(row, secret='SECRET_SENTINEL')]})
+                self.assertNotIn('SECRET_SENTINEL', str(caught.exception))
+        result = validate('profile', {'profiles': [{'id': 'x', 'aliases': 'old', 'invoke': 'run', 'detect': {'exe_names': 'x.exe'}}]})
+        self.assertEqual(result['profiles'][0]['aliases'], ['old'])
+        self.assertEqual(result['profiles'][0]['invoke'], ['run'])
+        self.assertEqual(result['profiles'][0]['detect']['exe_names'], ['x.exe'])
+
+
+if __name__ == '__main__':
+    unittest.main()
