+"""C3 基础批：只用替身声明进程 DPI，绝不修改测试宿主 awareness。"""
+import ctypes
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+from infra import app_icon
+import ui_tokens
+
+
+class DpiAwarenessTests(unittest.TestCase):
+    def setUp(self):
+        self.addCleanup(mock.patch.stopall)
+        mock.patch.object(app_icon, '_DPI_RESULT', None, create=True).start()
+        mock.patch.object(app_icon.sys, 'platform', 'win32').start()
+        self.context = mock.Mock(return_value=1)
+        self.shcore = mock.Mock(return_value=0)
+        self.legacy = mock.Mock(return_value=1)
+        self.dlls = {
+            'user32': SimpleNamespace(SetProcessDpiAwarenessContext=self.context,
+                                      SetProcessDPIAware=self.legacy),
+            'shcore': SimpleNamespace(SetProcessDpiAwareness=self.shcore),
+        }
+        self.loader = mock.patch.object(ctypes, 'WinDLL', side_effect=lambda name, **kw: self.dlls[name], create=True).start()
+        self.error = mock.patch.object(ctypes, 'get_last_error', return_value=0, create=True).start()
+        mock.patch.object(ctypes, 'set_last_error', create=True).start()
+
