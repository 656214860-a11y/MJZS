+            method = getattr(ctx.owner, legacy, None)
+        if not callable(method):
+            raise NotImplementedError('%s: %s requires a lifecycle owner' % (ctx.stage, operation))
+        return method(ctx)
+
+    def progress(self, ctx):
+        return self._call(ctx, 'progress', 'poll')
+
+    def pause(self, ctx):
+        return self._call(ctx, 'pause')
+
+    def resume(self, ctx):
+        return self._call(ctx, 'resume')
+
+    def cancel(self, ctx):
+        return self._call(ctx, 'cancel', 'stop')
+
+    def poll(self, ctx):
+        return self._call(ctx, 'poll', 'progress')
+
+    def stop(self, ctx):
+        return self._call(ctx, 'stop', 'cancel')
+
+
+def _legacy_start(ctx):
+    return ctx.fallback(ctx.stage, ctx.trigger) if callable(ctx.fallback) else ''
+
+
+def _storyboard_start(ctx):
+    return _finish_start(ctx, *_start_storyboard(ctx.desktop, ctx.trigger))
+
+
+def _animatic_start(ctx):
+    return _finish_start(ctx, error='分镜预演需要选择参考图与临时声音，生成后请您确认节奏、时长和对白同步',
+                         presentation=StagePresentation.SHOW_ANIMATIC)
+
+
+class StageRegistry:
+    """A closed catalog plus injected implementations, without global mutation.
+
+    A new L3 composition registers one pure record and its handler. Projections
+    consume this registry's definitions, so imported global tuples never drift.
+    """
+    def __init__(self, definitions=None, handlers=None):
+        self._definitions = []
+        self.handlers = {}
+        catalog = pet_bus.STAGE_DEFINITIONS if definitions is None else definitions
+        implementations = dict(HANDLERS if handlers is None else handlers)
+        for definition in catalog:
+            if definition.stage not in implementations:
+                raise ValueError('StageHandler missing for stage: ' + definition.stage)
+            self.register(definition, implementations[definition.stage])
+        for stage, handler in implementations.items():
+            if stage in self.handlers:
+                continue
+            if stage not in ('pet_test', 'pet_performance'):
+                raise ValueError('Stage definition missing: ' + stage)
+            self._validate_handler(handler)
+            self.handlers[stage] = handler
+
+    @property
+    def definitions(self):
+        return tuple(self._definitions)
+
+    @property
+    def stages(self):
+        return tuple(item.stage for item in self._definitions)
+
+    @staticmethod
+    def _validate_handler(handler):
+        missing = [name for name in ('start', 'pause', 'resume', 'cancel', 'progress')
+                   if not callable(getattr(handler, name, None))]
+        if missing:
+            aliases = {'progress': 'progress (poll)', 'cancel': 'cancel (stop)'}
+            raise TypeError('StageHandler missing: ' + ', '.join(aliases.get(name, name) for name in missing))
+
+    def register(self, definition, handler):
+        self._validate_handler(handler)
+        if definition.stage in self.stages or definition.stage in self.handlers:
+            raise ValueError('Stage already registered: ' + definition.stage)
+        if any(item.directory == definition.directory for item in self._definitions):
+            raise ValueError('Stage directory already registered: ' + definition.directory)
+        self._definitions.append(definition)
+        self.handlers[definition.stage] = handler
+
+
+HANDLERS = {item.stage: LegacyStageHandler(_legacy_start) for item in pet_bus.STAGE_DEFINITIONS}
+HANDLERS.update({
+    'storyboard': LegacyStageHandler(_storyboard_start),
+    'animatic': LegacyStageHandler(_animatic_start),
+    'pet_performance': LegacyStageHandler(
+        lambda ctx: _start_pet_performance(ctx.desktop, ctx.options.get('kind', 'startup'))),
+    'pet_test': LegacyStageHandler(
+        lambda ctx: _start_pet_test(ctx.desktop, ctx.options.get('text', ''))),
+})
+REGISTRY = StageRegistry(handlers=HANDLERS)
+
+
+def dispatch(ctx, registry=None, operation='start'):
+    """Execute a registered lifecycle without stage-specific branching."""
+    handlers = HANDLERS if registry is None else registry.handlers
+    handler = handlers.get(ctx.stage)
+    if handler is None:
+        # Unknown/non-production commands retain the previous callback behavior.
+        return _legacy_start(ctx) if operation == 'start' else NotImplemented
+    operation = {'poll': 'progress', 'stop': 'cancel'}.get(operation, operation)
+    if operation not in ('start', 'pause', 'resume', 'cancel', 'progress'):
+        raise ValueError('Unknown stage operation: ' + str(operation))
+    return getattr(handler, operation)(ctx)
