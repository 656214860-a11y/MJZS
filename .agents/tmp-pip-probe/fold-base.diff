+        self.assertEqual(ledger.call_count, 1)
+        self.assertEqual(ledger.return_value.authorize_model.call_count, 1)
+        self.assertEqual(result['request_usage']['calls'], 1)
+
+    def test_final_wire_schema_instructions_and_multimodal_text_are_evaluated(self):
