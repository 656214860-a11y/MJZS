+"""DPI startup order without changing the test process awareness."""
+import sys
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+from infra import app_icon
+import ui_tokens
+
+
+class EntryOrderingTests(unittest.TestCase):
+    def test_launch_initializes_scaling_before_desktop_widgets(self):
+        import desktop_launcher
+        events = []
+        window = mock.Mock()
+        modules = {
+            'tkinter': SimpleNamespace(Tk=lambda: events.append('root') or window),
+            'ui_widgets': SimpleNamespace(notify=mock.Mock()),
+            'desktop': SimpleNamespace(Desktop=lambda *a, **kw: events.append('widgets')),
+        }
+        with mock.patch.dict(sys.modules, modules), \
+                mock.patch.object(desktop_launcher, 'tk', modules['tkinter'], create=True), \
+                mock.patch.object(desktop_launcher, 'notify', mock.Mock(), create=True), \
+                mock.patch.object(app_icon, 'initialize_dpi_awareness',
+                                  side_effect=lambda: events.append('dpi')), \
+                mock.patch.object(ui_tokens, 'initialize_tk_scaling',
+                                  side_effect=lambda root: events.append('scaling')):
+            desktop_launcher.launch(selfcheck=False)
+        self.assertEqual(events, ['dpi', 'root', 'scaling', 'widgets'])
+        window.mainloop.assert_called_once()
+
+    def test_desktop_debug_main_scales_before_constructing_desktop(self):
+        import ast
+        from pathlib import Path
+        tree = ast.parse((Path(__file__).resolve().parents[1] / 'desktop.py').read_text(encoding='utf-8'))
+        main = tree.body[-1]
+        self.assertIsInstance(main, ast.If)
+        events = []
+        window = mock.Mock()
+        window.mainloop.side_effect = lambda: events.append('mainloop')
+        scope = {'tk': SimpleNamespace(Tk=lambda: events.append('root') or window),
+                 'Desktop': lambda root: events.append('widgets')}
+        with mock.patch.object(ui_tokens, 'initialize_tk_scaling',
+                               side_effect=lambda root: events.append('scaling')):
+            exec(compile(ast.Module(body=main.body, type_ignores=[]), 'desktop-debug-main', 'exec'), scope)
+        self.assertEqual(events, ['root', 'scaling', 'widgets', 'mainloop'])
+
+    def test_desktop_debug_declares_dpi_before_importing_ui(self):
+        import builtins
+        import runpy
+        from pathlib import Path
+        original = builtins.__import__
+        events = []
+
+        class ReachedUI(BaseException):
+            pass
+
+        def guarded(name, *args, **kwargs):
+            if name.startswith('ui.') or name == 'tkinter':
+                events.append('ui')
+                raise ReachedUI()
+            return original(name, *args, **kwargs)
+
+        with mock.patch.object(app_icon, 'initialize_dpi_awareness',
+                               side_effect=lambda: events.append('dpi')), \
+                mock.patch('builtins.__import__', side_effect=guarded):
+            with self.assertRaises(ReachedUI):
+                runpy.run_path(str(Path(__file__).resolve().parents[1] / 'desktop.py'), run_name='__main__')
+        self.assertEqual(events, ['dpi', 'ui'])
+
+    def test_app_debug_declares_dpi_before_importing_tk(self):
+        import builtins
+        import runpy
+        from pathlib import Path
+        original = builtins.__import__
+        events = []
+
+        class ReachedTk(BaseException):
+            pass
+
+        def guarded(name, *args, **kwargs):
+            if name == 'tkinter':
+                events.append('tk')
+                raise ReachedTk()
+            return original(name, *args, **kwargs)
+
+        with mock.patch.object(app_icon, 'initialize_dpi_awareness',
+                               side_effect=lambda: events.append('dpi')), \
+                mock.patch('builtins.__import__', side_effect=guarded):
+            with self.assertRaises(ReachedTk):
+                runpy.run_path(str(Path(__file__).resolve().parents[1] / 'app.py'), run_name='__main__')
+        self.assertEqual(events, ['dpi', 'tk'])
+
+    def test_formal_entry_declares_dpi_before_any_startup_side_effect(self):
+        import os
+        import runpy
+        from pathlib import Path
+        previous_cwd, previous_path = os.getcwd(), list(sys.path)
+        self.addCleanup(os.chdir, previous_cwd)
+        self.addCleanup(lambda: sys.path.__setitem__(slice(None), previous_path))
+
+        class Declared(BaseException):
+            pass
+
+        with mock.patch.object(app_icon, 'initialize_dpi_awareness', side_effect=Declared), \
+                mock.patch.dict(sys.modules, {'app_icon': app_icon}):
+            with self.assertRaises(Declared):
+                runpy.run_path(str(Path(__file__).resolve().parents[2] / '启动漫剧制作助手.pyw'), run_name='__main__')
+
+
+if __name__ == '__main__':
+    unittest.main()
