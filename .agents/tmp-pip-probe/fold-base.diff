+"""真实 import-linter 行为；开发依赖缺失时明确失败，不以 mock 代替。"""
+from __future__ import annotations
+
+import configparser
+from pathlib import Path
+import tempfile
+import unittest
+
+from scripts import check_import_contracts as contracts
+
+
+class TestImportContracts(unittest.TestCase):
+    def test_native_contract_rejects_reverse_and_only_ignores_exact_edge(self):
+        import grimp
+        from importlinter.configuration import configure
+        from importlinter.contracts.forbidden import ForbiddenContract
+        configure()
+        graph = grimp.ImportGraph()
+        for name in ("sample.low", "sample.high", "sample.other"):
+            graph.add_module(name)
+        options = {"source_modules": ["sample.low"],
+                   "forbidden_modules": ["sample.high", "sample.other"],
+                   "allow_indirect_imports": "True", "as_packages": "False"}
+        def check(extra=None):
+            from copy import deepcopy
+            return ForbiddenContract("fixture", {"root_packages": ["sample"]}, dict(options, **(extra or {}))).check(deepcopy(graph), verbose=False)
+        graph.add_import(importer="sample.high", imported="sample.low", line_number=1, line_contents="import sample.low")
+        self.assertTrue(check().kept)
+        graph.add_import(importer="sample.low", imported="sample.high", line_number=2, line_contents="import sample.high")
+        self.assertFalse(check().kept)
+        exact = {"ignore_imports": ["sample.low -> sample.high"]}
+        self.assertTrue(check(exact).kept)
+        graph.add_import(importer="sample.low", imported="sample.other", line_number=3, line_contents="import sample.other")
+        self.assertFalse(check(exact).kept)
+
+    def test_real_package_and_flat_sources_share_entity_graph(self):
+        import grimp
+        import sys
+        from importlinter.configuration import configure
+        from importlinter.contracts.forbidden import ForbiddenContract
+        configure()
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            package = root / "c7fixturecontract"
+            package.mkdir()
+            (package / "__init__.py").write_text("", encoding="utf-8")
+            low = package / "low.py"
+            high = root / "fixturehigh.py"
+            low.write_text("import fixturehigh\n", encoding="utf-8")
+            high.write_text("", encoding="utf-8")
+            names = {"low": "c7fixturecontract.low", "fixturehigh": "fixturehigh"}
+            sys.path.insert(0, directory)
+            try:
+                def check():
+                    graph = grimp.build_graph("c7fixturecontract", cache_dir=None)
+                    (graph, _) = contracts.bridge_legacy_entities(graph, names, [low, high])
+                    options = {"source_modules": ["c7fixturecontract.low"],
+                               "forbidden_modules": ["fixturehigh"],
+                               "allow_indirect_imports": "True", "as_packages": "False"}
+                    return ForbiddenContract("cross boundary", {"root_packages": ["c7fixturecontract", "fixturehigh"]}, options).check(graph, verbose=False)
+                self.assertFalse(check().kept, "package -> flat upward must fail")
+                low.write_text("", encoding="utf-8")
+                high.write_text("import low\n", encoding="utf-8")
+                self.assertTrue(check().kept, "legal flat high -> package low must pass")
+                graph = grimp.build_graph("c7fixturecontract", cache_dir=None)
+                graph, _ = contracts.bridge_legacy_entities(graph, names, [low, high])
+                graph, added_again = contracts.bridge_legacy_entities(graph, names, [low, high])
+                self.assertEqual(added_again, 0, "entity edges must be deduplicated")
+                self.assertEqual(graph.find_modules_directly_imported_by("fixturehigh"), {"c7fixturecontract.low"})
+                options = {"source_modules": ["fixturehigh"], "forbidden_modules": ["c7fixturecontract.low"],
+                           "allow_indirect_imports": "True", "as_packages": "False"}
+                self.assertFalse(ForbiddenContract("flat upward", {"root_packages": ["c7fixturecontract", "fixturehigh"]}, options).check(graph, verbose=False).kept)
+            finally:
+                sys.path.remove(directory)
+
+    def test_generated_config_matches_registry(self):
+        self.assertEqual(contracts.CONFIG.read_text(encoding="utf-8"), contracts.render())
+
+    def test_registry_change_detects_config_drift(self):
+        changed = dict(contracts.LAYERS, synthetic_future_module=0)
+        self.assertNotEqual(contracts.render(layers=changed), contracts.render())
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "contracts.ini"
+            path.write_text(contracts.render(), encoding="utf-8")
+            self.assertFalse(contracts.config_matches(path, layers=changed))
+
+    def test_all_layers_and_exact_ledger_edges_are_declared(self):
+        config = configparser.ConfigParser()
+        config.read_string(contracts.render())
+        self.assertEqual(len(config.sections()) - 1, len(set(contracts.LAYERS.values())) - 1)
+        declared = set()
+        for section in config.sections()[1:]:
+            for edge in config[section].get("ignore_imports", "").splitlines():
+                if edge.strip():
+                    self.assertNotIn("*", edge)
+                    declared.add(edge.strip())
+        self.assertEqual(declared, {f"{source} -> {target}" for source, target in contracts.exact_ignores()})
+        self.assertEqual(len(declared), len(contracts.exact_ignores()))
+        import grimp
+        from copy import deepcopy
+        from importlinter.configuration import configure
+        from importlinter.contracts.forbidden import ForbiddenContract
+        configure()
+        for source, target in contracts.exact_ignores():
+            with self.subTest(source=source, target=target):
+                graph = grimp.ImportGraph()
+                nearby = target + "_unregistered_neighbor"
+                for node in (source, target, nearby):
+                    graph.add_module(node)
+                graph.add_import(importer=source, imported=target, line_number=1, line_contents="fixture")
+                options = {"source_modules": [source], "forbidden_modules": [target, nearby],
+                           "allow_indirect_imports": "True", "as_packages": "False"}
+                session = {"root_packages": sorted({node.split('.')[0] for node in (source, target, nearby)})}
+                self.assertFalse(ForbiddenContract("ledger fixture", session, options).check(deepcopy(graph), verbose=False).kept)
+                options["ignore_imports"] = [f"{source} -> {target}"]
+                self.assertTrue(ForbiddenContract("ledger fixture", session, options).check(deepcopy(graph), verbose=False).kept)
+                graph.add_import(importer=source, imported=nearby, line_number=2, line_contents="fixture extra")
+                self.assertFalse(ForbiddenContract("ledger fixture", session, options).check(graph, verbose=False).kept)
+
+    def test_native_package_edge_is_found_before_legacy_bridge(self):
+        import sys
+        import importlib
+        import grimp
+        from importlinter.configuration import configure
+        from importlinter.contracts.forbidden import ForbiddenContract
+        configure()
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            for name in ('c7nativelow', 'c7nativehigh'):
+                folder = root / name
+                folder.mkdir()
+                (folder / '__init__.py').write_text('', encoding='utf-8')
+            (root / 'c7nativelow' / 'source.py').write_text('import c7nativehigh.target\n', encoding='utf-8')
+            (root / 'c7nativehigh' / 'target.py').write_text('', encoding='utf-8')
+            sys.path.insert(0, directory)
+            importlib.invalidate_caches()
+            try:
+                graph = grimp.build_graph('c7nativelow', 'c7nativehigh', cache_dir=None)
+                self.assertIn('c7nativehigh.target', graph.find_modules_directly_imported_by('c7nativelow.source'))
+                options = {'source_modules': ['c7nativelow.source'],
+                           'forbidden_modules': ['c7nativehigh.target'],
+                           'allow_indirect_imports': 'True', 'as_packages': 'False'}
+                check = ForbiddenContract('native before bridge',
+                    {'root_packages': ['c7nativelow', 'c7nativehigh']}, options).check(graph, verbose=False)
+                self.assertFalse(check.kept)
+            finally:
+                sys.path.remove(directory)
+                importlib.invalidate_caches()
+
+    def test_full_exit_and_release_ci_run_the_real_engine(self):
+        from scripts import local_ci
+        for steps in (local_ci.FULL_STEPS, local_ci.EXIT_STEPS, local_ci.RELEASE_STEPS):
+            with self.subTest(steps=steps):
+                commands = [command for _label, command in steps]
+                self.assertIn(['scripts/check_import_contracts.py'], commands)
+                self.assertNotIn(['scripts/check_import_contracts.py', '--check'], commands)
+
+    def test_repository_native_contracts(self):
+        result = contracts.check_repository()
+        self.assertEqual(result["broken"], [], result)
+        self.assertEqual(result["contracts"], len(set(contracts.LAYERS.values())) - 1)
+        self.assertTrue(result["origins"]["grimp._rustgrimp"].endswith(".pyd"))
+
+
+if __name__ == "__main__":
+    unittest.main()
