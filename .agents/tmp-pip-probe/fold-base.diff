+    def test_unwatch_uses_own_ids_and_old_idle_never_accesses_tk(self):
+        foreign=self.root.bind('<Configure>',lambda e:None,add='+')
+        self.root.emit('<Configure>'); old=next(iter(self.root.jobs.values()))
+        self.state.unwatch(self.root)
+        self.assertIn(('<Configure>',foreign),self.root.bindings)
+        self.root.winfo_exists=Mock(side_effect=AssertionError('late Tk'))
+        old(); self.read.assert_not_called(); self.apply.assert_not_called()
+        self.assertEqual(len(self.root.unbound),2)
+    def test_old_job_cannot_clear_new_pending(self):
+        self.root.emit('<Configure>'); old=next(iter(self.root.jobs.values()))
+        self.state.unwatch(self.root); self.state.watch(self.root)
+        self.root.emit('<Configure>'); pending=self.state.pending
+        old(); self.assertEqual(self.state.pending,pending)
+        self.root.run(pending[0]); self.apply.assert_called_once()
+    def test_root_destroy_closes_before_late_idle_and_zero_tk(self):
+        self.root.emit('<Configure>'); old=next(iter(self.root.jobs.values()))
