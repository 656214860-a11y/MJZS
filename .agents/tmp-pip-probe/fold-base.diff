+++ "b/\347\250\213\345\272\217/infra/config_validation.py"
@@ -0,0 +1,235 @@
+"""C4 只读配置校验核心：不选择路径、不写盘、不拥有第二份缓存。
+
+调用方负责后续接线及错误呈现。未知字段深拷贝保留；历史缺版本数据只在内存
+标记当前版本，不代表磁盘迁移。此版本号独立于客户端档案及产物 schema_version。
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Annotated
+
+from pydantic import (BaseModel, BeforeValidator, ConfigDict, Field, StrictBool,
+                      StrictInt, StrictStr, ValidationError, model_serializer)
+import infra.file_cache as file_cache
+
+__all__ = ['CURRENT_CONFIG_SCHEMA_VERSION', 'ConfigValidationError', 'validate', 'read_config', 'publish_global']
+
+CURRENT_CONFIG_SCHEMA_VERSION = 1
+PositiveInt = Annotated[StrictInt, Field(gt=0)]
+Hour = Annotated[StrictInt, Field(ge=0, le=23)]
+NonemptyStr = Annotated[StrictStr, Field(pattern=r'\S')]
+
+
+def _legacy_strings(value):
+    # 仅 client_profiles._strings / normalize_profile 明确支持的字段使用。
+    return [value] if isinstance(value, str) else value
+
+
+LegacyStrings = Annotated[list[StrictStr], BeforeValidator(_legacy_strings)]
+
+
+class ConfigValidationError(ValueError):
+    """仅包含安全 kind、声明字段路径与固定错误码，不保存原始异常或配置。"""
+
+    def __init__(self, kind, issues):
+        self.kind = kind if kind in _SCHEMAS else 'unknown'
+        self.issues = tuple({'path': tuple(item['path']), 'type': item['type']} for item in issues)
+        summary = '; '.join('.'.join(map(str, item['path'])) + ':' + item['type']
+                            for item in self.issues)
+        super().__init__(self.kind + ': ' + summary)
+
+
+class _Config(BaseModel):
+    model_config = ConfigDict(strict=True, validate_default=True, extra='allow', hide_input_in_errors=True)
+
+
+class _Sparse(_Config):
+    @model_serializer(mode='wrap')
+    def _present_fields(self, handler):
+        return {key: value for key, value in handler(self).items() if key in self.model_fields_set}
+
+
+class _Versioned(_Config):
+    config_schema_version: Annotated[StrictInt, Field(ge=1, le=1)] = CURRENT_CONFIG_SCHEMA_VERSION
+
+
+class _Project(_Versioned):
+    auto_review: StrictBool = False
+    auto_adopt: StrictBool = False
+    auto_edit: StrictBool = False
+    auto_submit: StrictBool = False
+    auto_keyframe: StrictBool = False
+    auto_asset: StrictBool = False
+    auto_video: StrictBool = False
+    auto_previs: StrictBool = False
+    auto_final: StrictBool = False
+    auto_handoff: StrictBool = False
+
+
+class _Endpoint(_Sparse):
+    base_url: StrictStr = ''
+    key_env: StrictStr = ''
+    path: StrictStr = ''
+    responses_path: StrictStr = ''
+    wire_api: StrictStr = ''
+    model: StrictStr = ''
+
+
+class _Model(_Endpoint):
+    label: StrictStr = ''
+    provider: StrictStr = ''
+    note: StrictStr = ''
+    program: StrictStr = ''
+    call_mode: StrictStr = ''
+    provider_label: StrictStr = ''
+    modality: StrictStr = ''
+    rpm: StrictStr | PositiveInt = ''
+    group: StrictStr = ''
+    weight: StrictStr | PositiveInt = ''
+    capabilities: list[StrictStr] = Field(default_factory=list)
+    context_window: StrictStr | PositiveInt = ''
+    context_length: StrictStr | PositiveInt = ''
+    cost: Annotated[StrictInt, Field(ge=1, le=3)] = 1
+    max_output_tokens: StrictStr | PositiveInt = ''
+
+
+class _AgentRoles(_Sparse):
+    default: StrictStr = ''
+    chat: StrictStr = ''
+    escalate: StrictStr = ''
+    fallback: StrictStr = ''
+
+
+class _Agent(_Sparse):
+    name: StrictStr = '三虎'
+    models: _AgentRoles = Field(default_factory=_AgentRoles)
+
+
+class _Budget(_Config):
+    tokens_per_day: PositiveInt = 2000000
+
+
+class _Global(_Versioned):
+    # 与 infra.pet_llm.DEFAULTS 对齐；不导入会读取生产配置的模块。
+    base_url: StrictStr = 'https://api.deepseek.com'
+    path: StrictStr = '/chat/completions'
+    responses_path: StrictStr = '/responses'
+    wire_api: StrictStr = 'chat'
+    flash_model: StrictStr = 'deepseek-v4-flash'
+    pro_model: StrictStr = 'deepseek-v4-pro'
+    key_env: StrictStr = 'DEEPSEEK_API_KEY'
+    timeout: PositiveInt = 60
+    off_peak: Annotated[list[Hour], Field(min_length=2, max_length=2)] | tuple[Hour, Hour] = Field(default_factory=lambda: [23, 7])
+    max_tokens: dict[StrictStr, PositiveInt] = Field(default_factory=dict)
+    force_tier: StrictStr = ''
+    fallback: _Endpoint = Field(default_factory=_Endpoint)
+    budget: _Budget = Field(default_factory=_Budget)
+    models: dict[StrictStr, _Model] = Field(default_factory=dict)
+    agent: _Agent = Field(default_factory=_Agent)
+    deleted_desktop_models: list[StrictStr] = Field(default_factory=list)
+
+
+class _StorePackage(_Config):
+    package: NonemptyStr
+    relative: StrictStr = ''
+
+
+class _Detect(_Sparse):
+    exe_names: LegacyStrings = Field(default_factory=list)
+    known_dirs: LegacyStrings = Field(default_factory=list)
+    known_globs: LegacyStrings = Field(default_factory=list)
+    registry: LegacyStrings = Field(default_factory=list)
+    store_packages: list[_StorePackage] = Field(default_factory=list)
+
+
+class _Window(_Sparse):
+    titles: LegacyStrings = Field(default_factory=list)
+    classes: LegacyStrings = Field(default_factory=list)
+
+
+class _Profile(_Sparse):
+    id: NonemptyStr
+    kind: StrictStr = 'desktop'
+    display: StrictStr = ''
+    aliases: LegacyStrings = Field(default_factory=list)
+    detect: _Detect = Field(default_factory=_Detect)
+    process_names: LegacyStrings = Field(default_factory=list)
+    window: _Window = Field(default_factory=_Window)
+    delivery: StrictStr = 'paste'
+    invoke: LegacyStrings = Field(default_factory=list)
+    output: StrictStr = ''
+
+
+class _Profiles(_Versioned):
+    schema_version: Annotated[StrictInt, Field(ge=1, le=1)] = 1
+    profiles: list[_Profile] = Field(default_factory=list)
+
+
+_SCHEMAS = {'global': _Global, 'project': _Project, 'profile': _Profiles}
+_FIELDS = frozenset(name for model in (_Versioned, _Project, _Endpoint, _Model, _AgentRoles,
+                                      _Agent, _Budget, _Global, _StorePackage, _Detect,
+                                      _Window, _Profile, _Profiles) for name in model.model_fields)
+_ERROR_TYPES = frozenset(('bool_type', 'int_type', 'string_type', 'list_type', 'dict_type',
+                          'model_type', 'greater_than', 'greater_than_equal', 'less_than_equal',
+                          'too_short', 'too_long', 'missing', 'string_pattern_mismatch'))
+
+
+def _error(kind, code, path=()):
+    return ConfigValidationError(kind, [{'path': path, 'type': code}])
+
+
+def validate(kind, mapping):
+    """校验 global/project/profile 对象并返回独立新 dict；不改输入或磁盘。"""
+    if not isinstance(kind, str) or kind not in _SCHEMAS:
+        raise _error('unknown', 'unknown_kind')
+    if not isinstance(mapping, dict):
+        raise _error(kind, 'object_required')
+    try:
+        model = _SCHEMAS[kind].model_validate(mapping)
+    except ValidationError as error:
+        issues = []
+        for item in error.errors(include_url=False, include_context=False, include_input=False):
+            # 字典键来自用户输入，不能原样放入错误路径（可能本身就是凭据）。
+            path = tuple(part if type(part) is int or part in _FIELDS else '*'
+                         for part in item['loc'])
+            issues.append({'path': path, 'type': item['type'] if item['type'] in _ERROR_TYPES else 'invalid_value'})
+    else:
+        result = model.model_dump()
+        if kind == 'global' and 'models' not in model.model_fields_set:
+            result.pop('models', None)
+        return deepcopy(result)
+    # 在except作用域外抛出，避免__context__保留Pydantic原始input。
+    raise ConfigValidationError(kind, issues) from None
+
+
+def read_config(kind, path, reader=file_cache.read_json):
+    """复用注入 reader 的缓存；仅文件缺失可用默认值，坏数据绝不静默降级。"""
+    if not isinstance(kind, str) or kind not in _SCHEMAS:
+        raise _error('unknown', 'unknown_kind')
+    failure = None
+    try:
+        data = reader(path)
+    except FileNotFoundError:
+        data = {}
+    except (ValueError, UnicodeError):
+        failure = 'read_invalid'
+    except OSError:
+        failure = 'read_failed'
+    if failure:
+        raise _error(kind, failure) from None
+    return validate(kind, data)
+
+
+def publish_global(path, mutate, *, snapshot_dir, reader, publisher, snapshot, access=None):
+    """调用方给定路径/依赖；同一发布锁内严格重读，候选通过后才快照与保存。"""
+    if access is None:
+        from agent.publication import access
+    with access():
+        current = read_config('global', path, reader=reader)
+        candidate = mutate(current)
+        if candidate is None:
+            return None
+        validated = validate('global', candidate)
+        snapshot(path, snapshot_dir, 'pool')
+        publisher(path, validated)
+        return validated
