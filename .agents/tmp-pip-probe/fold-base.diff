+"""C5：登记变化必须反映到文档，写入严格限制在生成标记内。"""
+from __future__ import annotations
+
+import contextlib
+import io
+from pathlib import Path
+import tempfile
+import unittest
+
+from scripts import generate_layer_docs as docs
+from tests.architecture._layers import LAYERS, LAYER_NAMES
+
+
+class LayerDocumentationTests(unittest.TestCase):
+    def test_repository_region_matches_registry(self):
+        text = docs.DOCUMENT.read_bytes().decode("utf-8")
+        self.assertEqual(docs.replace_region(text, docs.render()), text)
+
+    def test_render_uses_registry_module_and_layer_name_values(self):
+        layers = {"fake_contract": 0, "fake_ui": 4}
+        names = {0: "L0 测试契约", 4: "L4 测试界面"}
+        rendered = docs.render(layers, names)
+        self.assertIn("L0 测试契约", rendered)
+        self.assertIn("`fake_contract`", rendered)
+        layers["fake_contract"] = 4
+        names[4] = "L4 改名界面"
+        changed = docs.render(layers, names)
+        self.assertNotEqual(rendered, changed)
+        self.assertIn("| L0 测试契约 | 0 | — |", changed)
+        self.assertIn("| L4 改名界面 | 2 | `fake_contract`、`fake_ui` |", changed)
+
+    def test_all_real_registered_modules_are_rendered_once(self):
+        rendered = docs.render()
+        for name in LAYERS:
+            self.assertEqual(rendered.count(f"`{name}`"), 1, name)
+        for label in LAYER_NAMES.values():
+            self.assertIn(label, rendered)
+
+    def test_cli_check_is_readonly_and_write_is_scoped_and_idempotent(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            path = Path(temporary) / "architecture.md"
+            before = "前文职责\r\n" + docs.BEGIN + "\r\n过时表\r\n" + docs.END + "\r\n后文契约\r\n"
+            path.write_bytes(before.encode("utf-8"))
+            with contextlib.redirect_stdout(io.StringIO()):
+                self.assertEqual(docs.main(["--check", "--document", str(path)]), 1)
+                self.assertEqual(path.read_bytes(), before.encode("utf-8"))
+                self.assertEqual(docs.main(["--write", "--document", str(path)]), 0)
+                first = path.read_bytes()
+                self.assertTrue(first.startswith(("前文职责\r\n" + docs.BEGIN).encode("utf-8")))
+                self.assertTrue(first.endswith((docs.END + "\r\n后文契约\r\n").encode("utf-8")))
+                self.assertEqual(docs.main(["--check", "--document", str(path)]), 0)
+                self.assertEqual(docs.main(["--write", "--document", str(path)]), 0)
+                self.assertEqual(path.read_bytes(), first)
+
+    def test_invalid_or_repeated_markers_fail_without_writing(self):
+        for text in ("无标记", docs.END + docs.BEGIN, docs.BEGIN + docs.BEGIN + docs.END):
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    docs.replace_region(text, docs.render())
+                with tempfile.TemporaryDirectory() as temporary:
+                    path = Path(temporary) / "architecture.md"
+                    original = text.encode("utf-8")
+                    path.write_bytes(original)
+                    with contextlib.redirect_stdout(io.StringIO()):
+                        self.assertEqual(docs.main(["--write", "--document", str(path)]), 1)
+                    self.assertEqual(path.read_bytes(), original)
+
+
+if __name__ == "__main__":
+    unittest.main()
