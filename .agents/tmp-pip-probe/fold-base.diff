+                transport.assert_not_called()
+
+    def test_storyboard_uses_final_adapter_rejection_and_keeps_character_guard(self):
+        from types import SimpleNamespace
+        from orchestrator import storyboard_direct_api
+        from contract.workflow_context_budget import REQUEST_CONTEXT_MAX_CHARS
+        for window in (None, 10):
+            adapter, transport = self.adapter(window=window)
+            batch = SimpleNamespace(system='', record=record(window=window), adapter=adapter,
+                                    cancelled=lambda: False, chosen='fixture-model', project='fixture',
+                                    stage='storyboard', group_candidates=[])
+            with patch('infra.stage_model_value.reasoning_options', return_value={}), \
+                    patch.object(adapter, 'prepare_request', wraps=adapter.prepare_request) as prepare, \
+                    patch.object(router.model_pool, 'http_stream') as http:
+                with self.assertRaisesRegex(ValueError, '模型请求失败'):
+                    storyboard_direct_api._ask(batch, [{'role': 'user', 'content': '正文'}])
+                prepare.assert_called_once()
+                http.assert_not_called()
+                transport.assert_not_called()
+            with patch.object(adapter, 'stream') as stream:
+                with self.assertRaisesRegex(ValueError, '300,000'):
+                    storyboard_direct_api._ask(batch, [{'role': 'user', 'content': 'a' * (REQUEST_CONTEXT_MAX_CHARS + 1)}])
+                stream.assert_not_called()
+
+    def test_wrapped_frozen_window_cannot_override_explicit_server_narrowing(self):
+        adapter, transport = self.adapter(window=128000)
+        transport.side_effect = lambda *_args: {'ok': False, 'status': 400,
+            'error': 'maximum context length is 60000 tokens'}
+        wrapped = writing_api.WritingRequestAdapter(adapter, record(window=128000), 'fixture-model')
+        messages = [{'role': 'user', 'content': 'a' * 195000}]
+        with patch('writing_api.stage_model_value.reasoning_options', return_value={}):
+            first = wrapped.chat(messages, {'max_tokens': 100})
+            self.assertEqual(first['error_class'], 'context_overflow')
+            self.assertEqual(adapter.record['context_length'], 60000)
+            second = wrapped.chat(messages, {'max_tokens': 100})
+        self.assertEqual(second['reason'], 'context_budget_exceeded')
+        self.assertEqual(wrapped.record['context_length'], 128000)
+        transport.assert_called_once()
+
+    def test_stream_rejects_foreign_prepared_without_raising_or_sending(self):
+        adapter, _transport = self.adapter()
+        other, _ = self.adapter()
+        prepared = other.prepare_request([{'role': 'user', 'content': '正文'}],
+                                          {'max_tokens': 100}, 'fixture-model')
+        with patch.object(router.model_pool, 'http_stream') as http:
+            rejected = adapter.stream([], model='fixture-model', prepared=prepared)
+        self.assertFalse(rejected['ok'])
+        self.assertIn('prepared request does not match', rejected['error'])
+        http.assert_not_called()
+
+    def test_parallel_prepared_requests_keep_their_own_payload(self):
+        adapter, transport = self.adapter()
+        def send(i):
+            messages = [{'role': 'user', 'content': str(i)}]
+            prepared = adapter.prepare_request(messages, {'max_tokens': 100}, 'fixture-model')
+            return adapter.chat(messages, model='fixture-model', prepared=prepared)
+        with ThreadPoolExecutor(max_workers=4) as executor:
+            results = list(executor.map(send, range(16)))
+        self.assertTrue(all(result['ok'] for result in results))
+        self.assertEqual({call.args[1]['messages'][0]['content'] for call in transport.call_args_list},
+                         {str(i) for i in range(16)})
+
+
+if __name__ == '__main__':
+    unittest.main()
