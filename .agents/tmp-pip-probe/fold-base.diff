+        self.unbound=[]; self.cancelled=[]
+    def _root(self): return self.root
+    def winfo_exists(self): return self.alive
+    def bind(self, event, callback, add=None):
+        self.sequence+=1; key=str(self.sequence); self.bindings[(event,key)]=callback; return key
+    def unbind(self,event,key):
+        self.unbound.append((event,key)); self.bindings.pop((event,key),None)
+    def after_idle(self, callback):
+        self.sequence+=1; key='job'+str(self.sequence); self.jobs[key]=callback; return key
+    def after_cancel(self,key): self.cancelled.append(key)
+    def emit(self,event,widget=None):
+        for (kind,_),callback in list(self.bindings.items()):
+            if kind==event: callback(SimpleNamespace(widget=self if widget is None else widget))
+    def run(self,key=None):
+        key=key or next(reversed(self.jobs)); self.jobs.pop(key)()
+
+
+class DpiWatchTests(unittest.TestCase):
+    def setUp(self):
