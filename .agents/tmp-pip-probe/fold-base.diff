@@ -0,0 +1,191 @@
+"""Dev-only registry -> native import-linter forbidden contracts.
+
+Grimp scans real packages; the existing package-aware AST scanner bridges legacy
+flat modules. No product module is imported. Dynamic guards remain independent.
+Run with optional dev dependencies on child PYTHONPATH; --check is read-only,
+--write refreshes only the declarative config. Default executes native contracts.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import configparser
+import importlib
+import json
+import os
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+# CI显式选择独立开发target；不读取产品设置、不把开发包装入生产runtime。
+DEV_TARGET = os.environ.get("IMPORT_CONTRACTS_DEV_TARGET")
+if DEV_TARGET:
+    target = Path(DEV_TARGET).resolve()
+    if not target.is_dir():
+        raise RuntimeError("Requested import-contract development target is missing")
+    sys.path.insert(0, str(target))
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+from tests.architecture._layers import LAYERS, LAYER_NAMES
+from tests.architecture._scan import PACKAGE_NAMES, entity_file, module_import_rows, module_scan_files
+from tests.architecture.test_layers import _layer_ledger
+
+CONFIG = ROOT / ".importlinter"
+
+
+def entities(layers=None):
+    result = {}
+    for name in (LAYERS if layers is None else layers):
+        path = entity_file(name)
+        result[name] = ".".join(path.relative_to(ROOT).with_suffix("").parts)
+    return result
+
+
+def exact_ignores():
+    names = entities()
+    record = _layer_ledger()
+    return sorted({(names[item["importer"]], names[item["imported"]]) for item in record["items"]})
+
+
+def render(layers=None):
+    layers = LAYERS if layers is None else layers
+    names = entities(layers)
+    lines = ["# Generated from tests/architecture/_layers.py; do not edit.",
+             "[importlinter]", "root_packages =", *[f"    {name}" for name in sorted(set(PACKAGE_NAMES) | {value.split('.')[0] for value in names.values()})], ""]
+    for level in sorted(set(layers.values()))[:-1]:
+        sources = sorted(names[name] for name, layer in layers.items() if layer == level)
+        targets = sorted(names[name] for name, layer in layers.items() if layer > level)
+        lines += [f"[importlinter:contract:L{level}]", f"name = {LAYER_NAMES[level]} upward boundary",
+                  "type = forbidden", "allow_indirect_imports = True", "as_packages = False", "source_modules =",
+                  *[f"    {name}" for name in sources], "forbidden_modules =", *[f"    {name}" for name in targets]]
+        ignores = [(source, target) for source, target in exact_ignores() if source in sources and target in targets]
+        if ignores:
+            lines += ["ignore_imports =", *[f"    {source} -> {target}" for source, target in ignores]]
+        lines += [""]
+    return "\n".join(lines)
+
+
+def config_matches(path=CONFIG, layers=None):
+    return path.is_file() and path.read_text(encoding="utf-8") == render(layers)
+
+
+def native_origins():
+    from importlib.metadata import version
+    expected = {"import-linter": "2.16", "grimp": "3.20"}
+    for distribution, pinned in expected.items():
+        if version(distribution) != pinned:
+            raise RuntimeError(f"{distribution} must be {pinned}")
+    origins = {name: str(Path(importlib.import_module(name).__file__).resolve())
+               for name in ("importlinter", "grimp", "grimp._rustgrimp")}
+    expected_target = os.environ.get("IMPORT_CONTRACTS_DEV_TARGET")
+    if expected_target:
+        target = Path(expected_target).resolve()
+        if any(not Path(origin).is_relative_to(target) for origin in origins.values()):
+            raise RuntimeError("import-linter / Grimp did not load from requested isolated target")
+    if Path(origins["grimp._rustgrimp"]).suffix != ".pyd":
+        raise RuntimeError("Native Windows Grimp extension required")
+    return origins
+
+
+def repository_graph():
+    import grimp
+    graph = grimp.build_graph(*sorted(PACKAGE_NAMES), cache_dir=None)
+    native_modules = len(graph.modules)
+    return bridge_legacy_entities(graph, entities(), module_scan_files()), native_modules
+
+
+def bridge_legacy_entities(graph, names, paths):
+    """Use existing scanner canonicalization; keep every real native package edge."""
+    for name in names.values():
+        if name not in graph.modules:
+            graph.add_module(name)
+    # A forwarding shell is represented once, by the same entity as _scan.
+    # Canonicalize native flat imports before adding scanner's flat-source edges.
+    reverse = {name: names[name] for name in names}
+    for source in sorted(graph.modules):
+        for target in tuple(graph.find_modules_directly_imported_by(source)):
+            canonical = reverse.get(target, target)
+            if canonical != target:
+                details = graph.get_import_details(importer=source, imported=target)
+                graph.remove_import(importer=source, imported=target)
+                for detail in details:
+                    graph.add_import(importer=source, imported=canonical,
+                                     line_number=detail["line_number"], line_contents=detail["line_contents"])
+    added = 0
+    for path in paths:
+        source = names.get(path.stem)
+        if source is None:
+            continue
+        source_text = path.read_text(encoding="utf-8")
+        rows = list(module_import_rows(path))
+        # `from contract import x` has the same entity as `import contract.x`.
+        # The old scanner intentionally also retains the package-root edge.
+        for node in ast.walk(ast.parse(source_text)):
+            if isinstance(node, ast.ImportFrom) and node.module in PACKAGE_NAMES and not node.level:
+                rows.extend((node.lineno, alias.name) for alias in node.names
+                            if names.get(alias.name) == f"{node.module}.{alias.name}")
+        for line, target in rows:
+            target = names.get(target)
+            if target is not None and target != source:
+                if target not in graph.find_modules_directly_imported_by(source):
+                    added += 1
+                graph.add_import(importer=source, imported=target, line_number=line,
+                                 line_contents=source_text.splitlines()[line - 1])
+    return graph, added
+
+
+def check_repository(config=CONFIG):
+    from importlinter.configuration import configure
+    from importlinter.contracts.forbidden import ForbiddenContract
+    configure()
+    origins = native_origins()
+    if not config_matches(config):
+        raise ValueError("Contract config drift; run scripts/check_import_contracts.py --write")
+    parsed = configparser.ConfigParser()
+    parsed.read(config, encoding="utf-8")
+    (graph, added), native_modules = repository_graph()
+    broken, results = [], []
+    for section in parsed.sections()[1:]:
+        raw = dict(parsed[section])
+        name = raw.pop("name")
+        raw.pop("type")
+        for key in ("source_modules", "forbidden_modules", "ignore_imports"):
+            if key in raw:
+                raw[key] = raw[key].split()
+        # Ignore entries contain spaces around ->; preserve each complete edge.
+        if "ignore_imports" in parsed[section]:
+            raw["ignore_imports"] = parsed[section]["ignore_imports"].strip().splitlines()
+        session = {"root_packages": parsed["importlinter"]["root_packages"].split()}
+        contract = ForbiddenContract(name, session, raw)
+        from copy import deepcopy
+        check = contract.check(deepcopy(graph), verbose=False)
+        results.append({"name": name, "kept": check.kept, "metadata": check.metadata})
+        if not check.kept:
+            broken.append(name)
+    return {"contracts": len(results), "broken": broken, "results": results,
+            "origins": origins, "native_package_modules": native_modules,
+            "scanner_bridge_new_edges": added, "modules": len(graph.modules),
+            "exact_ignores": len(exact_ignores())}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument("--check", action="store_true")
+    mode.add_argument("--write", action="store_true")
+    args = parser.parse_args(argv)
+    if args.write:
+        CONFIG.write_text(render(), encoding="utf-8")
+        print("Updated .importlinter")
+        return 0
+    if args.check:
+        ok = config_matches()
+        print("Contract config synchronized" if ok else "Contract config drift")
+        return 0 if ok else 1
+    result = check_repository()
+    print(json.dumps(result, ensure_ascii=False, indent=2, default=str))
+    return bool(result["broken"])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
