@@ -0,0 +1,68 @@
+"""C3有限顶层监听最小真Tk集成；仅注入DPI读数，不设置进程awareness。"""
+import tkinter as tk
+import unittest
+from unittest.mock import Mock
+
+from ui import ui_rounded
+from ui_tokens import initialize_tk_scaling, pixel_dimensions, TABLE_EMPTY_PADDING
+from ui_widgets import (BaseDialog, DataTable, refresh_table_dpi, refresh_dialog_dpi,
+                        watch_top_dpi)
+
+
+class DpiWatchTkTests(unittest.TestCase):
+    def test_registered_top_events_refresh_existing_table_and_dialog_without_user_state_changes(self):
+        root=tk.Tk(); root.withdraw()
+        initialize_tk_scaling(root,dpi=96)
+        observations={'dpi':96}; calls=[]
+        def apply(window,*,dpi):
+            calls.append(('apply',dpi)); initialize_tk_scaling(window,dpi=dpi)
+        def refresh(window):
+            calls.append(('refresh',observations['dpi']))
+            refresh_table_dpi(window); refresh_dialog_dpi(window)
+        state=watch_top_dpi(root,read_dpi=lambda top:observations['dpi'],apply_dpi=apply,refresh=refresh)
+        try:
+            selected=Mock()
+            table=DataTable(root,columns=[('name','名称',101)],on_select=selected)
+            table.tree.column('name',stretch=False); table.tree.column('#0',stretch=False)
+            row=table.tree.insert('', 'end', values=('fixture',)); table.tree.selection_set(row)
+            dialog=BaseDialog(root,'标准',geometry='360x240+30+30',modal=False)
+            legacy=BaseDialog(root,'旧浮窗',modal=False,chrome=False)
+            self.assertIn(root,state.tops); self.assertIn(dialog,state.tops)
+            self.assertNotIn(legacy,state.tops); legacy.destroy()
+            root.update_idletasks(); root.update()
+            selected.reset_mock(); geometry=dialog.geometry(); minimum=dialog.minsize()
+            table.tree.column('name',width=123)
+            for dpi in (144,192,96):
+                observations['dpi']=dpi
+                for _ in range(20): dialog.event_generate('<Configure>',when='now')
+                root.update_idletasks()
+                self.assertEqual(table.tree.column('name','width'),pixel_dimensions(root,(123,))[0])
+                self.assertEqual(table.tree.selection(),(row,))
+                self.assertEqual(dialog.geometry(),geometry)
+                self.assertEqual(dialog.minsize(),minimum)
+                self.assertEqual(tuple(map(int,root.tk.splitlist(table.empty_label.cget('padding')))),
+                                 pixel_dimensions(root,(TABLE_EMPTY_PADDING,)))
+                self.assertFalse(table.empty_label.winfo_ismapped())
+                selected.assert_not_called()
+            count=len(calls); resources=(tuple(root.tk.call('image','names')),tuple(root.tk.call('font','names')))
+            for _ in range(20): dialog.event_generate('<Configure>',when='now')
+            root.update_idletasks()
+            self.assertEqual(len(calls),count)
+            self.assertEqual(resources,(tuple(root.tk.call('image','names')),tuple(root.tk.call('font','names'))))
+            self.assertEqual([value for name,value in calls if name=='apply'],[144,192,96])
+            dialog.event_generate('<Configure>',when='now')
+            pending=state.pending
+            self.assertIsNotNone(pending)
+            dialog.destroy()
+            state._run(pending[1])
+            self.assertIsNone(state.pending)
+            root.update_idletasks()
+            root.event_generate('<Configure>',when='now'); pending=state.pending
+            root.destroy()
+            state._run(pending[1])
+            self.assertTrue(state.closed)
+        finally:
+            if not state.closed: root.destroy()
+
+
+if __name__=='__main__': unittest.main()
