+r"""开发期发布端：生成 TUF 元数据与签名目标包（不进分发副本、不写仓库私钥）。
+
+信任边界：
+
+- 四个角色（root／targets／snapshot／timestamp）的 **Ed25519 私钥种子只在构建机本地**
+  ``--keys`` 目录（仓库外）读取，本脚本绝不写私钥，也拒绝在 Git 工作树内生成密钥。
+- 客户端只拿到 ``root.json``（公开公钥）与已签名元数据；root 轮换、离线密钥保管与
+  真实发布地址由发布流程人工决定（见 ``docs/specs/03_安装签名与分发.md``）。
+- 优先用 ``cryptography``（真实发布建议安装到开发环境）；未安装时退回
+  securesystemslib 自带的 Ed25519 参考实现，仅适合本地构建与自动化测试。
+
+用法（随附解释器，工作目录 ``程序``）::
+
+    python.exe -B scripts\update_publish.py --generate-keys D:\release-keys\c8
+    python.exe -B scripts\update_publish.py --repository D:\release\repo --keys D:\release-keys\c8 --version 0.8.2
+"""
+from __future__ import annotations
+
+import argparse
+import io
+import json
+import os
+import sys
+import zipfile
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+PROGRAM_DIR = Path(__file__).resolve().parents[1]
+if str(PROGRAM_DIR) not in sys.path:
+    sys.path.insert(0, str(PROGRAM_DIR))
+
+from infra import update_notice  # noqa: E402  (脚本目录注入后导入)
+
+sys.dont_write_bytecode = True
+
+ROLES = ('root', 'targets', 'snapshot', 'timestamp')
+SEED_NAME = '%s.ed25519.seed'
+PROTECTED = frozenset({'config.json', 'projects.json', 'desktop_settings.json',
+                       'private', 'data', '升级备份', 'logs', '配置', '.upgrade-tmp'})
+MAX_PAYLOAD_BYTES = 512 * 1024 * 1024
+
+
+def _canonical_seed(text):
+    seed = bytes.fromhex(str(text or '').strip())
+    if len(seed) != 32:
+        raise ValueError('Ed25519 种子必须是 32 字节（64 位十六进制）')
+    return seed
+
+
+class VendoredEd25519Signer:
+    """无 ``cryptography`` 时的签名器：复用 securesystemslib 自带参考实现。"""
+
+    def __init__(self, seed):
+        from securesystemslib._vendor.ed25519 import ed25519
+        from securesystemslib.signer import SSlibKey, Signature
+        from securesystemslib.signer._utils import compute_default_keyid
+
+        self._ed = ed25519
+        self._signature = Signature
+        self._seed = seed
+        self._public = ed25519.publickey_unsafe(seed)
+        keyval = {'public': self._public.hex()}
+        keyid = compute_default_keyid('ed25519', 'ed25519', keyval)
+        self._key = SSlibKey(keyid, 'ed25519', 'ed25519', keyval)
+
+    @classmethod
+    def from_priv_key_uri(cls, priv_key_uri, public_key, secret_store=None):
+        raise NotImplementedError('本签名器只在本进程内接收种子')
+
+    @property
+    def public_key(self):
+        return self._key
+
+    def sign(self, payload):
+        signature = self._ed.signature_unsafe(payload, self._seed, self._public)
+        return self._signature(self._key.keyid, signature.hex())
+
+
+def signer_for(seed):
+    """返回 (signer, backend)；优先 cryptography，缺失时用自带参考实现。"""
+    try:
+        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+        from securesystemslib.signer import CryptoSigner
+
+        return CryptoSigner(Ed25519PrivateKey.from_private_bytes(seed)), 'cryptography'
+    except ImportError:
+        return VendoredEd25519Signer(seed), 'vendored-ed25519'
+
+
+def _inside_git_tree(path):
+    current = Path(path).resolve()
+    for parent in (current, *current.parents):
+        if (parent / '.git').exists():
+            return True
+    return False
+
+
+def _check_keys_location(path, allow_temporary):
+    """私钥目录默认不得位于 Git 工作树；测试临时目录显式放行（内容不提交）。"""
+    if allow_temporary:
+        return Path(path).resolve()
+    target = Path(path).resolve()
+    if _inside_git_tree(target):
+        raise ValueError('发布私钥目录不得位于 Git 工作树内：%s' % target)
+    return target
+
+
+def generate_keys(keys_dir, *, allow_temporary=False):
+    """在仓库外目录生成四个角色的种子文件；返回角色列表。"""
+    target = _check_keys_location(keys_dir, allow_temporary)
+    target.mkdir(parents=True, exist_ok=True)
+    written = []
+    for role in ROLES:
+        path = target / (SEED_NAME % role)
+        if path.exists():
+            raise ValueError('密钥已存在，拒绝覆盖：%s' % path)
+        with open(path, 'w', encoding='utf-8') as stream:
+            stream.write(os.urandom(32).hex() + '\n')
+        try:
+            os.chmod(path, 0o600)
+        except OSError:
+            pass
+        written.append(role)
+    return written
+
+
+def load_signers(keys_dir, *, allow_temporary=False):
+    """读取四个角色种子并返回 (signers, backend)；私钥不落日志、不返回种子。"""
+    directory = _check_keys_location(keys_dir, allow_temporary)
+    signers, backends = {}, set()
+    for role in ROLES:
+        path = directory / (SEED_NAME % role)
+        try:
+            seed = _canonical_seed(path.read_text(encoding='utf-8'))
+        except OSError as exc:
+            raise ValueError('缺少发布密钥 %s：%s' % (role, path)) from exc
+        signers[role], backend = signer_for(seed)
+        backends.add(backend)
+    return signers, '+'.join(sorted(backends))
+
+
+def _payload_files(program_dir):
+    """枚举要打包的程序文件；受保护数据与缓存不进入升级包。"""
+    program = Path(program_dir).resolve()
+    files = []
+    for path in sorted(program.rglob('*')):
+        if not path.is_file() or path.is_symlink():
+            continue
+        relative = path.relative_to(program)
+        if relative.parts[0].casefold() in {item.casefold() for item in PROTECTED}:
+            continue
+        if '__pycache__' in relative.parts or path.suffix.lower() == '.pyc':
+            continue
+        files.append(relative)
+    return files
+
+
+def build_payload(program_dir):
+    """把程序目录打成确定性顺序的 ZIP 字节流（不含受保护数据）。"""
+    program = Path(program_dir).resolve()
+    files = _payload_files(program)
+    if not files:
+        raise ValueError('程序目录没有任何可打包文件：%s' % program)
+    total = sum((program / relative).stat().st_size for relative in files)
+    if total > MAX_PAYLOAD_BYTES:
+        raise ValueError('升级包体积超限：%d 字节' % total)
+    buffer = io.BytesIO()
+    with zipfile.ZipFile(buffer, 'w', zipfile.ZIP_DEFLATED) as archive:
+        for relative in files:
+            info = zipfile.ZipInfo(relative.as_posix(), date_time=(1980, 1, 1, 0, 0, 0))
+            info.compress_type = zipfile.ZIP_DEFLATED
+            info.external_attr = 0o644 << 16
+            archive.writestr(info, (program / relative).read_bytes())
+    return buffer.getvalue()
+
+
+def _next_version(path):
+    """读取已有元数据的版本号并加一；不存在从 1 开始。"""
+    from tuf.api.metadata import Metadata
+
+    if not Path(path).is_file():
+        return 1
+    return int(Metadata.from_file(str(path)).signed.version) + 1
+
+
+def _build_root(signers, expires, consistent_snapshot=False):
+    from tuf.api.metadata import Metadata, Root
+
+    root = Metadata(Root(expires=expires, consistent_snapshot=consistent_snapshot))
+    for role in ROLES:
+        root.signed.add_key(signers[role].public_key, role)
+    root.sign(signers['root'])
+    return root
+
+
+def _read_or_build_root(repository, signers, expires):
+    from tuf.api.metadata import Metadata
+
+    root_path = Path(repository) / 'metadata' / 'root.json'
+    if not root_path.is_file():
+        root = _build_root(signers, expires)
+        root.to_file(str(root_path))
+        return root
+    root = Metadata.from_file(str(root_path))
+    if root.signed.type != 'root':
+        raise ValueError('repository/metadata/root.json 不是 root 元数据')
+    role = root.signed.roles.get('root')
+    if role is None or signers['root'].public_key.keyid not in role.keyids:
+        raise ValueError('现有 root.json 的 root 角色不包含当前 root 密钥；'
+                         '变更根密钥须走离线轮换，不能原地重签')
+    if root.signed.expires < expires:
+        root.signed.expires = expires
+        root.signatures.clear()
+        root.sign(signers['root'])
+        root.to_file(str(root_path))
+    return root
+
+
+def publish(repository, program_dir, keys_dir, version, *, platform='win_amd64',
+            expires_days=7, min_client_version=None, root_out=None, now=None,
+            payload=None, allow_temporary_keys=False):
+    """生成一整套 TUF 元数据与签名目标包；返回公开摘要（不含密钥材料）。
+
+    ``repository`` 布局：``metadata/{root,targets,snapshot,timestamp}.json`` +
+    ``targets/program-<platform>.zip``。``root_out`` 是给客户端内置的信任锚副本。
+    """
+    parsed = update_notice.parse_version(version)
+    if parsed is None:
+        raise ValueError('版本号无法解析：%r' % version)
+    repository = Path(repository).resolve()
+    metadata_dir = repository / 'metadata'
+    targets_dir = repository / 'targets'
+    metadata_dir.mkdir(parents=True, exist_ok=True)
+    targets_dir.mkdir(parents=True, exist_ok=True)
+    signers, backend = load_signers(keys_dir, allow_temporary=allow_temporary_keys)
+    moment = now or datetime.now(timezone.utc)
+    expires = moment + timedelta(days=int(expires_days))
+    root = _read_or_build_root(repository, signers, expires)
+
+    raw = payload if payload is not None else build_payload(program_dir)
+    target = 'program-%s.zip' % platform
+    from tuf.api.metadata import (Metadata, MetaFile, Snapshot, TargetFile, Targets,
+                                  Timestamp)
+
+    targets_meta = Metadata(Targets(version=_next_version(metadata_dir / 'targets.json'),
+                                    expires=expires))
+    target_file = TargetFile.from_data(target, raw, ['sha256'])
+    custom = {'app_version': str(version), 'platform': platform}
+    if min_client_version:
+        custom['min_client_version'] = str(min_client_version)
+    target_file.unrecognized_fields['custom'] = custom
+    targets_meta.signed.targets[target] = target_file
+    targets_meta.sign(signers['targets'])
+    targets_bytes = targets_meta.to_bytes()
+    targets_meta.to_file(str(metadata_dir / 'targets.json'))
+
+    snapshot_meta = Metadata(Snapshot(version=_next_version(metadata_dir / 'snapshot.json'),
+                                      expires=expires))
+    snapshot_meta.signed.meta['targets.json'] = MetaFile.from_data(
+        targets_meta.signed.version, targets_bytes, ['sha256'])
+    snapshot_meta.sign(signers['snapshot'])
+    snapshot_bytes = snapshot_meta.to_bytes()
+    snapshot_meta.to_file(str(metadata_dir / 'snapshot.json'))
+
+    timestamp_meta = Metadata(Timestamp(version=_next_version(metadata_dir / 'timestamp.json'),
+                                        expires=expires))
+    timestamp_meta.signed.snapshot_meta = MetaFile.from_data(
+        snapshot_meta.signed.version, snapshot_bytes, ['sha256'])
+    timestamp_meta.sign(signers['timestamp'])
+    timestamp_meta.to_file(str(metadata_dir / 'timestamp.json'))
+
+    with open(targets_dir / target, 'wb') as stream:
+        stream.write(raw)
+    root_bytes = root.to_bytes()
+    with open(metadata_dir / ('%d.root.json' % root.signed.version), 'wb') as stream:
+        stream.write(root_bytes)
+    anchor = Path(root_out) if root_out else repository / 'trusted-root.json'
+    anchor.parent.mkdir(parents=True, exist_ok=True)
+    with open(anchor, 'wb') as stream:
+        stream.write(root_bytes)
+
+    return {'repository': str(repository), 'target': target, 'version': str(version),
+            'platform': platform, 'root': str(anchor), 'signer_backend': backend,
+            'target_sha256': target_file.hashes['sha256'],
+            'target_length': len(raw),
+            'targets_version': targets_meta.signed.version,
+            'snapshot_version': snapshot_meta.signed.version,
+            'timestamp_version': timestamp_meta.signed.version,
+            'metadata': sorted(path.name for path in metadata_dir.iterdir())}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--generate-keys', type=Path, default=None,
+                        help='在仓库外目录生成四角色 Ed25519 种子后退出')
+    parser.add_argument('--repository', type=Path, default=None, help='发布仓库输出目录')
+    parser.add_argument('--program', type=Path, default=PROGRAM_DIR, help='要打包的程序目录')
+    parser.add_argument('--keys', type=Path, default=None, help='仓库外的发布密钥目录')
+    parser.add_argument('--version', default=None, help='应用版本号，如 0.8.2')
+    parser.add_argument('--platform', default='win_amd64')
+    parser.add_argument('--expires-days', type=int, default=7)
+    parser.add_argument('--min-client-version', default=None)
+    parser.add_argument('--root-out', type=Path, default=None, help='信任锚 root.json 输出路径')
+    args = parser.parse_args(argv)
+    if args.generate_keys:
+        roles = generate_keys(args.generate_keys)
+        print(json.dumps({'generated': roles, 'directory': str(args.generate_keys)},
+                         ensure_ascii=False))
+        return 0
+    missing = [name for name in ('repository', 'keys', 'version') if not getattr(args, name)]
+    if missing:
+        parser.error('缺少参数：%s（或使用 --generate-keys）' % ', '.join(missing))
+    summary = publish(args.repository, args.program, args.keys, args.version,
+                      platform=args.platform, expires_days=args.expires_days,
+                      min_client_version=args.min_client_version, root_out=args.root_out)
+    print(json.dumps(summary, ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
