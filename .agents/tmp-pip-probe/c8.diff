+                                             mover=flaky_mover)
+        self.assertGreaterEqual(calls['count'], 2)
+        self.assertEqual(_read(self.install_root / 'app.py'), 'APP = "old"\n')
+        self.assertEqual(_read(self.install_root / 'ui' / 'desktop.py'), 'DESKTOP = "old"\n')
