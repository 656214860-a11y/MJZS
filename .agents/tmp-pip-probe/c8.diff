@@ -0,0 +1,267 @@
+"""L1 升级安装事务：安全解包 → 逐文件原子替换 → 失败回滚 → 用户数据保护。
+
+设计要点（C8）：
+
+- 只替换升级清单（ZIP 条目）列出的程序文件；未列出的文件（``config.json``、
+  ``projects.json``、``desktop_settings.json``、``private/``、``data/``、``升级备份/``、
+  日志、全局配置目录）即使出现在包内也直接拒绝，绝不删除、移动或覆盖。
+- 解包不用 ``extractall``：逐条目校验绝对路径、``..``、盘符、Windows 保留名、
+  尾随点／空格、ADS 冒号、符号链接与大小上限，防 zip slip 与 zip bomb。
+- 事务：先把旧文件移入同卷临时备份目录，再把新文件移入正式路径；任一步失败即
+  反向恢复旧文件，新文件交给 ``storage_maintenance.recycle_paths`` 回收而非直接删除。
+- 不做 shell 调用：全程纯 Python，``os.replace`` 经注入的 ``mover`` 单点收口。
+"""
+from __future__ import annotations
+
+import os
+import time
+import uuid
+import zipfile
+from dataclasses import dataclass
+from pathlib import Path
+
+from contract.infra_errors import StorageError
+from infra import storage_maintenance
+
+__all__ = [
+    'MAX_ENTRY_BYTES', 'MAX_TOTAL_BYTES', 'PROTECTED_ROOTS', 'InstallError',
+    'UnsafePayload', 'install_archive', 'install_update', 'plan_entries',
+    'staging_root',
+]
+
+MAX_ENTRY_BYTES = 64 * 1024 * 1024
+MAX_TOTAL_BYTES = 512 * 1024 * 1024
+PROTECTED_ROOTS = frozenset({
+    'config.json', 'projects.json', 'desktop_settings.json',
+    'private', 'data', '升级备份', 'logs', '配置',
+})
+STAGING_DIR_NAME = '.upgrade-tmp'
+_INVALID_CHARS = frozenset('<>:"|?*')
+_RESERVED = frozenset({'CON', 'PRN', 'AUX', 'NUL'}
+                      | {'COM%d' % index for index in range(1, 10)}
+                      | {'LPT%d' % index for index in range(1, 10)})
+
+
+class InstallError(StorageError):
+    """安装事务失败；旧文件已尽力恢复，新文件已交回回收站。"""
+
+
+class UnsafePayload(InstallError):
+    """升级包路径／体积／条目类型越界，整包拒绝且不写入任何文件。"""
+
+
+@dataclass(frozen=True)
+class Entry:
+    """一个待安装条目：包内条目名与相对安装根的安全路径。"""
+
+    name: str
+    relative: Path
+    size: int
+
+
+def staging_root(install_root):
+    """升级事务临时目录的父目录；与安装根同卷，保证 ``os.replace`` 原子。"""
+    return Path(install_root) / STAGING_DIR_NAME
+
+
+def _segments(name):
+    """把 ZIP 条目名切成安全路径段；越界即 ``UnsafePayload``。"""
+    if not isinstance(name, str) or not name:
+        raise UnsafePayload('升级包条目名为空')
+    if '\\' in name:
+        raise UnsafePayload('升级包条目含反斜杠，拒绝歧义路径：%r' % name)
+    if name.startswith('/') or (len(name) > 1 and name[1] == ':'):
+        raise UnsafePayload('升级包条目是绝对路径：%r' % name)
+    parts = name.split('/')
+    for part in parts:
+        if part in ('', '.', '..'):
+            raise UnsafePayload('升级包条目含空段或上跳段：%r' % name)
+        if part != part.rstrip(' .') or part.endswith('.'):
+            raise UnsafePayload('升级包条目含尾随点或空格：%r' % name)
+        if any(char in _INVALID_CHARS or ord(char) < 32 for char in part):
+            raise UnsafePayload('升级包条目含非法字符：%r' % name)
+        if part.split('.')[0].upper() in _RESERVED:
+            raise UnsafePayload('升级包条目命中 Windows 保留名：%r' % name)
+    return parts
+
+
+def _relative_path(name):
+    """校验并返回相对安装根的路径；受保护根即使出现在包内也拒绝。"""
+    parts = _segments(name)
+    if parts[0].casefold() in {item.casefold() for item in PROTECTED_ROOTS}:
+        raise UnsafePayload('升级包试图覆盖受保护路径：%r' % name)
+    return Path(*parts)
+
+
+def plan_entries(archive_path):
+    """只读预检升级包，返回待安装条目；不写任何文件。"""
+    entries = []
+    seen = set()
+    total = 0
+    try:
+        archive = zipfile.ZipFile(archive_path)
+    except (OSError, zipfile.BadZipFile) as exc:
+        raise UnsafePayload('升级包无法打开：%s' % type(exc).__name__,
+                            detail={'path': str(archive_path)}) from exc
+    with archive:
+        for info in archive.infolist():
+            if info.is_dir():
+                continue
+            mode = (info.external_attr >> 16) & 0o170000
+            if mode == 0o120000:
+                raise UnsafePayload('升级包含符号链接条目：%r' % info.filename)
+            relative = _relative_path(info.filename)
+            key = '/'.join(part.casefold() for part in relative.parts)
+            if key in seen:
+                raise UnsafePayload('升级包条目大小写重复：%r' % info.filename)
+            seen.add(key)
+            if info.file_size > MAX_ENTRY_BYTES:
+                raise UnsafePayload('升级包单文件超限：%r（%d 字节）'
+                                    % (info.filename, info.file_size))
+            total += info.file_size
+            if total > MAX_TOTAL_BYTES:
+                raise UnsafePayload('升级包解压总量超限：%d 字节' % total)
+            entries.append(Entry(info.filename, relative, info.file_size))
+    if not entries:
+        raise UnsafePayload('升级包没有任何程序文件')
+    return entries
+
+
+def _check_ancestors(root, relative):
+    """拒绝经符号链接／junction 逃出安装根的既有路径。"""
+    current = Path(root)
+    is_junction = getattr(os.path, 'isjunction', None)
+    for part in relative.parts[:-1]:
+        current = current / part
+        if current.is_symlink() or (is_junction is not None and is_junction(current)):
+            raise UnsafePayload('安装目标路径经过链接目录：%s' % relative)
+    target = Path(root) / relative
+    if target.is_symlink() or (is_junction is not None and is_junction(target)):
+        raise UnsafePayload('安装目标是符号链接或 junction：%s' % relative)
+    if target.exists() and target.is_dir():
+        raise UnsafePayload('安装目标是目录：%s' % relative)
+    return target
+
+
+def _extract(archive_path, entry, staging_dir):
+    """把单条目写入事务暂存区；写入长度必须与声明一致。"""
+    destination = Path(staging_dir) / entry.relative
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    written = 0
+    try:
+        with zipfile.ZipFile(archive_path) as archive, archive.open(entry.name) as source, \
+                open(destination, 'wb') as target:
+            while True:
+                chunk = source.read(1024 * 1024)
+                if not chunk:
+                    break
+                written += len(chunk)
+                if written > entry.size or written > MAX_ENTRY_BYTES:
+                    raise UnsafePayload('升级包条目实际长度超出声明：%r' % entry.name)
+                target.write(chunk)
+    except (OSError, zipfile.BadZipFile, RuntimeError) as exc:
+        raise UnsafePayload('升级包解压失败：%s' % type(exc).__name__,
+                            detail={'entry': entry.name}) from exc
+    if written != entry.size:
+        raise UnsafePayload('升级包条目长度与 ZIP 声明不符：%r' % entry.name)
+    return destination
+
+
+def _move(source, target):
+    """同卷原子移动单点收口（所有移动都经这里，便于注入失败）。"""
+    target.parent.mkdir(parents=True, exist_ok=True)
+    os.replace(source, target)
+
+
+def _recycle_or_keep(root, path, reason):
+    """回收失败不掩盖安装结果；返回是否完成回收。"""
+    try:
+        storage_maintenance.recycle_paths(root, [path], reason)
+        return True
+    except (OSError, ValueError):
+        return False
+
+
+def _rollback(installed, backups, mover, transaction):
+    """反向恢复：先挪走已安装的新文件，再放回旧文件。返回恢复失败数。"""
+    failed = 0
+    for relative, target in reversed(installed):
+        try:
+            mover(target, transaction / 'failed' / relative)
+        except OSError:
+            failed += 1
+    for relative, backup, target in reversed(backups):
+        try:
+            mover(backup, target)
+        except OSError:
+            failed += 1
+    return failed
+
+
+def _apply(entry_pairs, transaction, mover, installed, backups):
+    """执行备份＋安装；部分状态由调用方持有，异常后仍可完整回滚。"""
+    for relative, target in entry_pairs:
+        if target.exists():
+            backup = transaction / 'old' / relative
+            mover(target, backup)
+            backups.append((relative, backup, target))
+    for relative, target in entry_pairs:
+        source = transaction / 'new' / relative
+        mover(source, target)
+        installed.append((relative, target))
+
+
+def install_archive(archive_path, install_root, *, version, now=None, mover=_move):
+    """把已验签升级包安装到 ``install_root``；失败自动回滚并抛 ``InstallError``。
+
+    返回回执：版本、安装文件数、事务目录与回收结果。旧版本文件经
+    ``storage_maintenance.recycle_paths`` 回收，可在回收站恢复。
+    """
+    root = Path(install_root).resolve()
+    if not root.is_dir():
+        raise InstallError('安装根不存在：%s' % root)
+    entries = plan_entries(archive_path)
+    pairs = []
+    for entry in entries:
+        target = _check_ancestors(root, entry.relative)
+        pairs.append((entry.relative, target))
+    token = time.strftime('%Y%m%d_%H%M%S', time.localtime(now if now is not None else time.time()))
+    transaction = staging_root(root) / ('%s-%s' % (token, uuid.uuid4().hex[:8]))
+    (transaction / 'new').mkdir(parents=True)
+    (transaction / 'old').mkdir()
+    installed = []
+    backups = []
+    try:
+        for entry in entries:
+            _extract(archive_path, entry, transaction / 'new')
+        _apply(pairs, transaction, mover, installed, backups)
+    except Exception as exc:
+        failed = _rollback(installed, backups, mover, transaction)
+        _recycle_or_keep(root, transaction, '升级安装失败，回收临时文件与未采用版本')
+        if isinstance(exc, InstallError):
+            raise
+        raise InstallError('升级安装失败，已回滚：%s' % type(exc).__name__,
+                           detail={'error': str(exc), 'rollback_failures': failed}) from exc
+    recycled = _recycle_or_keep(root, transaction / 'old',
+                                '升级安装完成，旧版程序文件归档')
+    _recycle_or_keep(root, transaction / 'new', '升级安装完成，清理空暂存目录')
+    try:
+        transaction.rmdir()
+    except OSError:
+        pass
+    return {'version': str(version or ''), 'installed': len(installed),
+            'files': [relative.as_posix() for relative, _target in installed],
+            'transaction': str(transaction), 'old_recycled': recycled}
+
+
+def install_update(source, install_root, *, current_version=None, archive=None):
+    """完整升级链：``source.check()`` → 下载 → 安装；无新版返回 ``current``。
+
+    校验失败或安装失败时 ``install_archive`` 已回滚；本函数不吞异常。
+    """
+    release = source.check()
+    if release is None:
+        return {'status': 'current', 'release': None}
+    archive_path = Path(archive) if archive is not None else source.download(release)
+    receipt = install_archive(archive_path, install_root, version=release.app_version)
+    return {'status': 'installed', 'release': release.summary(), 'receipt': receipt}
