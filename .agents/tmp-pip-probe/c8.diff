+    def test_no_shell_or_network_modules_are_used(self):
+        for module in (update_source, update_installer):
+            source = Path(module.__file__).read_text(encoding='utf-8')
+            self.assertNotIn('subprocess', source)
+            self.assertNotIn('urllib', source)
+            self.assertNotIn('socket', source)
+
+    def test_http_transport_maps_status_without_network(self):
+        class Result:
+            def __init__(self, ok, data, message=''):
+                self.ok = ok
+                self.data = data
+                self.message = message
+
+        calls = []
+
+        def request(method, url, **kwargs):
+            calls.append((method, url, kwargs))
+            return Result(**self.responses[url])
+
+        self.responses = {
+            'https://updates.invalid/good': dict(ok=True, data={'status': 200, 'body': b'abc'}),
+            'https://updates.invalid/missing': dict(ok=False, data={'status': 404}),
+            'https://updates.invalid/broken': dict(ok=False, data={'status': 500}),
+        }
+        fetch = update_source.http_transport(request=request, timeout=5)
+        self.assertEqual(fetch('https://updates.invalid/good'), (200, b'abc'))
+        self.assertEqual(fetch('https://updates.invalid/missing'), (404, b''))
+        with self.assertRaises(update_source.TransportError):
+            fetch('https://updates.invalid/broken')
+        self.assertEqual(calls[0][0], 'GET')
+
