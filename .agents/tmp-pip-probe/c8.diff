+        self.publish('0.9')
+        target = self.repository / 'targets' / 'program-win_amd64.zip'
+        tampered = Path(self.tmp.name) / 'tampered.zip'
+        with zipfile.ZipFile(target) as source, zipfile.ZipFile(tampered, 'w') as sink:
+            for info in source.infolist():
+                data = source.read(info.filename)
+                if info.filename == 'app.py':
+                    data = b'APP = "evil"\n'
+                sink.writestr(info.filename, data)
+        # 红：绕过验签直接安装篡改包，恶意内容会被写进程序目录。
+        update_installer.install_archive(tampered, self.install_root, version='0.9')
+        self.assertEqual(_read(self.install_root / 'app.py'), 'APP = "evil"\n')
+        # 红：把同样的篡改包放进发布仓库，元数据仍指向原始哈希。
+        with open(target, 'wb') as stream:
+            stream.write(tampered.read_bytes())
+        # 绿：恢复旧版后走生产链路，篡改包在安装前被元数据哈希拒绝。
+        self._seed_install_root()
+        with self.assertRaises(update_source.TargetRejected):
+            update_installer.install_update(self.source('0.8'), self.install_root)
+        self.assertEqual(_read(self.install_root / 'app.py'), 'APP = "old"\n')
+        self.assert_user_data_untouched()
