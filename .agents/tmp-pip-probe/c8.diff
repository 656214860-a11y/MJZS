+"""L1 可信升级源：内置 TUF root 信任锚 + 元数据验签 + 目标筛选 + 受控下载。
+
+边界（C8 升级执行器）：
+
+- 只信任调用方交付的本地 ``root.json`` 字节（``load_trusted_root``）；元数据、目标文件
+  一律经注入的 ``transport(url) -> (status, body)`` 获取，生产适配器走
+  ``infra.http_client.request_bytes``，测试注入内存仓库，模块自身不联网。
+- 发布私钥、签名角色与 root 轮换只存在于 ``scripts/update_publish.py``（开发期工具），
+  本模块不生成密钥、不写签名。
+- 只负责「有没有可用新版 + 安全下载到暂存」；解包、原子替换、数据保护与回滚在
+  ``infra.update_installer``，用户可见提示复用 ``infra.update_notice``。
+"""
+from __future__ import annotations
+
+import platform as _platform
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from contract.infra_errors import CorruptDataError, NetworkError
+from infra import update_notice
+from tuf.api.exceptions import (BadVersionNumberError, DownloadHTTPError,
+                                ExpiredMetadataError, LengthOrHashMismatchError,
+                                RepositoryError, UnsignedMetadataError)
+from tuf.ngclient import Updater
+from tuf.ngclient.fetcher import FetcherInterface
+
+__all__ = [
+    'DEFAULT_METADATA_BASE_URL', 'DEFAULT_TARGET_BASE_URL', 'Release', 'SourceOptions',
+    'TransportError', 'TrustError', 'TargetRejected', 'DowngradeRejected',
+    'UnsupportedPlatform', 'UpdateSource', 'http_transport', 'load_trusted_root',
+    'platform_tag', 'target_name',
+]
+
+DEFAULT_METADATA_BASE_URL = 'https://updates.invalid/metadata/'
+DEFAULT_TARGET_BASE_URL = 'https://updates.invalid/targets/'
+MAX_ROOT_BYTES = 512 * 1024
+TARGET_TEMPLATE = 'program-{platform}.zip'
+
+
+class UpdateSourceError(CorruptDataError):
+    """升级源技术异常根；兼容 ``except ValueError``。"""
+
+    code = 'E-IO-CORRUPT'
+    _allowed = frozenset({'E-IO-CORRUPT', 'E-CONTRACT-VIOLATION'})
+
+
+class TrustError(UpdateSourceError):
+    """root／元数据缺失、签名无效、过期或不完整。"""
+
+
+class TargetRejected(UpdateSourceError):
+    """目标包不满足元数据声明的长度／哈希／版本字段。"""
+
+
+class DowngradeRejected(UpdateSourceError):
+    """目标版本不高于当前版本，或元数据版本回放。"""
+
+    code = 'E-CONTRACT-VIOLATION'
+
+
+class UnsupportedPlatform(UpdateSourceError):
+    """当前平台没有对应的升级目标命名。"""
+
+    code = 'E-CONTRACT-VIOLATION'
+
+
+class TransportError(NetworkError):
+    """传输失败（超时、5xx、非 404 的错误码）。"""
+
+
+def platform_tag():
+    """当前平台的目标命名；仅支持 Windows（应用只交付 Windows 解释器）。"""
+    if sys.platform != 'win32':
+        raise UnsupportedPlatform('升级只支持 Windows，当前平台为 %s' % sys.platform)
+    machine = (_platform.machine() or '').lower()
+    if machine in ('amd64', 'x86_64'):
+        return 'win_amd64'
+    if machine in ('arm64', 'aarch64'):
+        return 'win_arm64'
+    raise UnsupportedPlatform('不支持的 CPU 架构：%s' % (machine or 'unknown'))
+
+
+def target_name(platform=None):
+    """升级目标在 TUF targets 里的固定名字。"""
+    return TARGET_TEMPLATE.format(platform=platform or platform_tag())
+
+
+def load_trusted_root(path):
+    """读取并结构校验随安装包交付的信任锚 root.json，返回原始字节。
+
+    只做本地解析与类型校验；真正的签名信任由 ``Updater(bootstrap=...)`` 覆盖，
+    不从网络拉取 root。
+    """
+    from tuf.api.metadata import Metadata
+
+    root_path = Path(path)
+    try:
+        size = root_path.stat().st_size
+        data = root_path.read_bytes()
+    except OSError as exc:
+        raise TrustError('缺少可信 root.json：%s' % root_path,
+                         detail={'path': str(root_path), 'error': type(exc).__name__}) from exc
+    if not data or size > MAX_ROOT_BYTES:
+        raise TrustError('可信 root.json 大小异常：%d 字节' % size)
+    try:
+        metadata = Metadata.from_bytes(data)
+    except Exception as exc:
+        raise TrustError('可信 root.json 无法解析',
+                         detail={'error': type(exc).__name__}) from exc
+    if metadata.signed.type != 'root':
+        raise TrustError('可信信任锚不是 root 元数据：%s' % metadata.signed.type)
+    return data
+
+
+def http_transport(*, timeout=30, request=None):
+    """生产传输适配器：唯一出站入口 ``http_client.request_bytes`` 的薄包装。
+
+    ``request`` 可注入以替换传输实现；返回 ``(status, body)``，404 交给 TUF
+    fetcher 翻译成 ``DownloadHTTPError``。
+    """
+    from infra import http_client
+
+    send = request or http_client.request_bytes
+
+    def fetch(url):
+        result = send('GET', url, timeout=timeout, retries=1)
+        data = getattr(result, 'data', None) or {}
+        status = int(data.get('status') or 0)
+        if not getattr(result, 'ok', False):
+            if status == 404:
+                return 404, b''
+            raise TransportError('升级源请求失败：%s' % (getattr(result, 'message', '') or url),
+                                 detail={'url': url, 'status': status})
+        body = data.get('body')
+        if not isinstance(body, (bytes, bytearray)):
+            raise TransportError('升级源响应缺少字节体', detail={'url': url})
+        return status or 200, bytes(body)
+
+    return fetch
+
+
+def _compare_versions(candidate, baseline):
+    """版本元组比较：返回 1／0／-1；任一侧不可解析返回 0（由调用方决定语义）。"""
+    left = update_notice.parse_version(candidate)
+    right = update_notice.parse_version(baseline)
+    if left is None or right is None:
+        return 0
+    size = max(len(left), len(right))
+    left = tuple(left) + (0,) * (size - len(left))
+    right = tuple(right) + (0,) * (size - len(right))
+    return (left > right) - (left < right)
+
+
+class _TransportFetcher(FetcherInterface):
+    """把注入传输接到 python-tuf；不实现任何网络栈。"""
+
+    def __init__(self, transport):
+        self._transport = transport
+        self.calls = []
+
+    def _fetch(self, url):
+        status, body = self._transport(url)
+        self.calls.append((url, status))
+        if status >= 400:
+            raise DownloadHTTPError('升级源不存在：%s（HTTP %s）' % (url, status), status)
+        yield body
+
+
+@dataclass
+class Release:
+    """一个可安装的升级目标（已通过元数据验签与防降级检查）。"""
+
+    name: str
+    app_version: str
+    platform: str
+    length: int
+    hashes: dict
+    required: bool = False
+    target: object = field(default=None, repr=False, compare=False)
+
+    def summary(self):
+        """供上层提示／日志使用的公开摘要，不含 TUF 内部对象。"""
+        return {'name': self.name, 'app_version': self.app_version,
+                'platform': self.platform, 'length': self.length,
+                'sha256': self.hashes.get('sha256', ''), 'required': self.required}
+
+
+@dataclass(frozen=True)
+class SourceOptions:
+    """可替换的升级源接口参数；默认值即生产布局（仓库 ``metadata/``＋``targets/``）。"""
+
+    metadata_base_url: str = DEFAULT_METADATA_BASE_URL
+    target_base_url: str = DEFAULT_TARGET_BASE_URL
+    target: str = ''
+    updater_factory: object = Updater
+
+
+class UpdateSource:
+    """一次升级会话的 TUF 客户端：``refresh -> check -> download``。"""
+
+    def __init__(self, metadata_dir, target_dir, *, transport, trusted_root,
+                 current_version, options=None):
+        if not isinstance(trusted_root, (bytes, bytearray)) or not trusted_root:
+            raise TrustError('可信 root 必须是本地 root.json 字节')
+        chosen = options or SourceOptions()
+        self.metadata_dir = Path(metadata_dir)
+        self.target_dir = Path(target_dir)
+        self._transport = transport
+        self._trusted_root = bytes(trusted_root)
+        self.current_version = str(current_version or '')
+        self.metadata_base_url = chosen.metadata_base_url
+        self.target_base_url = chosen.target_base_url
+        self.target = chosen.target or target_name()
+        self._updater_factory = chosen.updater_factory
+        self._updater = None
+        self.fetcher = _TransportFetcher(self._wrap_transport())
+
+    def _wrap_transport(self):
+        def guarded(url):
+            try:
+                return self._transport(url)
+            except TransportError:
+                raise
+            except OSError as exc:
+                raise TransportError('升级源连接失败：%s' % type(exc).__name__,
+                                     detail={'url': url}) from exc
+            except Exception as exc:
+                raise TransportError('升级源传输异常：%s' % type(exc).__name__,
+                                     detail={'url': url}) from exc
+        return guarded
+
+    def _client(self):
+        if self._updater is not None:
+            return self._updater
+        try:
+            self.metadata_dir.mkdir(parents=True, exist_ok=True)
+            self.target_dir.mkdir(parents=True, exist_ok=True)
+            self._updater = self._updater_factory(
+                str(self.metadata_dir), self.metadata_base_url, str(self.target_dir),
+                self.target_base_url, fetcher=self.fetcher, bootstrap=self._trusted_root)
+        except (OSError, ValueError) as exc:
+            raise TrustError('无法初始化升级源：%s' % type(exc).__name__,
+                             detail={'error': str(exc)}) from exc
+        return self._updater
+
+    def refresh(self):
+        """拉取并验签 timestamp/snapshot/targets（必要时轮换 root）。"""
+        try:
+            self._client().refresh()
+        except TransportError:
+            raise
+        except ExpiredMetadataError as exc:
+            raise TrustError('升级元数据已过期', detail={'error': type(exc).__name__}) from exc
+        except UnsignedMetadataError as exc:
+            raise TrustError('升级元数据签名无效或不受信任',
+                             detail={'error': type(exc).__name__}) from exc
+        except BadVersionNumberError as exc:
+            raise DowngradeRejected('拒绝回放旧版升级元数据',
+                                    detail={'error': type(exc).__name__}) from exc
+        except DownloadHTTPError as exc:
+            raise TransportError('升级元数据不可用：HTTP %s' % exc.status_code,
+                                 detail={'status': exc.status_code}) from exc
+        except (RepositoryError, OSError, ValueError) as exc:
+            raise TrustError('升级元数据校验失败：%s' % type(exc).__name__,
+                             detail={'error': str(exc)}) from exc
+        return self
+
+    def _compare(self, candidate):
+        """目标版本相对当前版本：1 更新／0 相同／-1 更旧；当前不可解析视为更新。"""
+        mine = update_notice.parse_version(self.current_version)
+        theirs = update_notice.parse_version(candidate)
+        if theirs is None:
+            raise TargetRejected('升级目标缺少可解析的版本号：%r' % candidate)
+        if mine is None:
+            return 1
+        return _compare_versions(candidate, self.current_version)
+
+    def check(self):
+        """返回可用 ``Release``；已是最新返回 ``None``。"""
+        self.refresh()
+        try:
+            info = self._client().get_targetinfo(self.target)
+        except (RepositoryError, ValueError, OSError) as exc:
+            raise TrustError('升级目标元数据不可用：%s' % type(exc).__name__,
+                             detail={'error': str(exc)}) from exc
+        if info is None:
+            return None
+        custom = (info.unrecognized_fields or {}).get('custom')
+        if not isinstance(custom, dict):
+            raise TargetRejected('升级目标缺少 custom 元数据')
+        version = str(custom.get('app_version') or '')
+        current = update_notice.parse_version(self.current_version)
+        required = bool(current is not None
+                        and _compare_versions(custom.get('min_client_version'), current) > 0)
+        comparison = self._compare(version)
+        if comparison < 0:
+            raise DowngradeRejected('升级目标版本 %s 低于当前版本 %s'
+                                    % (version, self.current_version),
+                                    detail={'target': version, 'current': self.current_version})
+        if comparison == 0:
+            return None
+        return Release(name=self.target, app_version=version,
+                       platform=str(custom.get('platform') or ''),
+                       length=info.length, hashes=dict(info.hashes),
+                       required=required, target=info)
+
+    def download(self, release):
+        """把已验证目标下载到 ``target_dir``，返回本地暂存路径。"""
+        if release is None or release.target is None:
+            raise TargetRejected('缺少可下载的升级目标')
+        try:
+            path = Path(self._client().download_target(release.target))
+        except LengthOrHashMismatchError as exc:
+            raise TargetRejected('升级包长度或哈希与元数据不符',
+                                 detail={'target': release.name}) from exc
+        except DownloadHTTPError as exc:
+            raise TransportError('升级包下载失败：HTTP %s' % exc.status_code,
+                                 detail={'status': exc.status_code}) from exc
+        except TransportError:
+            raise
+        except OSError as exc:
+            raise TransportError('升级包写入失败：%s' % type(exc).__name__,
+                                 detail={'error': str(exc)}) from exc
+        path = path.resolve()
+        if not path.is_file() or not path.is_relative_to(self.target_dir.resolve()):
+            raise TargetRejected('升级包落点不在受控暂存目录：%s' % path)
+        return path
