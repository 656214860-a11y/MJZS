+    def test_zip_slip_and_protected_paths_are_refused(self):
+        cases = {
+            'parent escape': {'../evil.txt': 'x'},
+            'absolute path': {'C:/Windows/evil.txt': 'x'},
+            'protected config': {'config.json': '{"leak": true}'},
+            'protected data dir': {'data/user.json': 'x'},
+            'protected backup dir': {'升级备份/x.zip': 'x'},
+            'case duplicate': {'App.py': 'a', 'app.py': 'b'},
+            'reserved name': {'CON.txt': 'x'},
+            'trailing dot': {'app.py.': 'x'},
+        }
+        for label, entries in cases.items():
+            with self.subTest(case=label):
+                archive = self._archive(entries)
+                with self.assertRaises(update_installer.UnsafePayload):
+                    update_installer.install_archive(archive, self.install_root, version='0.9')
+                self.assertEqual(_read(self.install_root / 'app.py'), 'APP = "old"\n')
+                self.assert_user_data_untouched()
