+        calls = {'count': 0}
+
+        def flaky_mover(move_source, move_target):
+            calls['count'] += 1
+            if calls['count'] == 2:
+                raise OSError('injected disk failure')
+            move_target.parent.mkdir(parents=True, exist_ok=True)
+            os.replace(move_source, move_target)
