+    def test_update_errors_belong_to_infra_error_family(self):
+        for name in ('UpdateSourceError', 'TrustError', 'TargetRejected',
+                     'DowngradeRejected', 'UnsupportedPlatform', 'TransportError'):
+            self.assertTrue(issubclass(getattr(update_source, name), infra_errors.InfraError))
+        for name in ('InstallError', 'UnsafePayload'):
+            self.assertTrue(issubclass(getattr(update_installer, name), infra_errors.InfraError))
