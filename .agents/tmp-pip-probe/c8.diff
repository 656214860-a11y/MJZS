+# -*- coding: utf-8 -*-
+"""C8 升级执行器 Windows 验收：发布端签名 → 客户端验签 → 下载 → 安装 → 数据保护 → 回滚。
+
+所有用例在真实临时目录运行，传输注入内存仓库映射，禁用 socket，不做任何真实网络请求，
+不生成或提交真实私钥（临时密钥目录位于系统临时目录，测试结束随临时目录删除）。
+"""
+import importlib.util
+import os
+import socket
+import sys
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+
+PROGRAM = Path(__file__).resolve().parents[1]
+if str(PROGRAM) not in sys.path:
+    sys.path.insert(0, str(PROGRAM))
+
+from contract import infra_errors  # noqa: E402
+from infra import storage_maintenance  # noqa: E402
+from infra import update_installer, update_source  # noqa: E402
+
+META_URL = 'https://updates.invalid/metadata/'
+TARGET_URL = 'https://updates.invalid/targets/'
+
+
+def _load_publisher():
+    path = PROGRAM / 'scripts' / 'update_publish.py'
+    spec = importlib.util.spec_from_file_location('update_publish_under_test', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+PUBLISH = _load_publisher()
+
+
+def _write(path, text):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, 'w', encoding='utf-8') as stream:
+        stream.write(text)
+
+
+def _read(path):
+    return Path(path).read_text(encoding='utf-8')
+
+
+class RepositoryTransport:
+    """把 TUF 请求映射到本地仓库目录；不打开任何 socket。"""
+
+    def __init__(self, repository):
+        self.repository = Path(repository)
+        self.calls = []
+
+    def __call__(self, url):
+        marker = '/metadata/' if '/metadata/' in url else '/targets/'
+        name = url.split(marker, 1)[1]
+        path = self.repository / marker.strip('/') / name
+        self.calls.append((name, path.is_file()))
+        if not path.is_file():
+            return 404, b''
+        with open(path, 'rb') as stream:
+            return 200, stream.read()
+
+
+class PipelineCase(unittest.TestCase):
+    """公共夹具：旧版本安装目录 + 新版本载荷 + 已签名仓库。"""
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='c8-update-')
+        self.addCleanup(self.tmp.cleanup)
+        base = Path(self.tmp.name)
+        self.repository = base / 'repo'
+        self.keys = base / 'keys'
+        self.install_root = base / 'install' / '程序'
+        self.payload_root = base / 'payload'
+        self.cache = base / 'cache'
+        PUBLISH.generate_keys(self.keys, allow_temporary=True)
+        self._seed_payload()
+        self._seed_install_root()
+
+    def _seed_payload(self):
+        _write(self.payload_root / 'app.py', 'APP = "new"\n')
+        _write(self.payload_root / 'ui' / 'desktop.py', 'DESKTOP = "new"\n')
+        _write(self.payload_root / 'infra' / 'update_notice.py', 'NOTICE = "new"\n')
+        _write(self.payload_root / 'data' / 'builtin.json', '{"internal": true}\n')
+        _write(self.payload_root / 'config.json', '{"leak": true}\n')
+
+    def _seed_install_root(self):
+        _write(self.install_root / 'app.py', 'APP = "old"\n')
+        _write(self.install_root / 'ui' / 'desktop.py', 'DESKTOP = "old"\n')
+        _write(self.install_root / 'infra' / 'update_notice.py', 'NOTICE = "old"\n')
+        _write(self.install_root / '旧版独有.py', 'LEGACY = "keep"\n')
+        self.user_files = {
+            'config.json': '{"user": 1}\n',
+            'projects.json': '{"projects": []}\n',
+            'desktop_settings.json': '{"theme": "dark"}\n',
+            'private/密钥.txt': 'private-secret\n',
+            'data/user.json': '{"user_data": true}\n',
+            '升级备份/backup.zip': 'historical backup\n',
+            'logs/app.log': 'log line\n',
+            '配置/global.json': '{"global": 1}\n',
+        }
+        for name, text in self.user_files.items():
+            _write(self.install_root / name, text)
+
+    def publish(self, version, **kwargs):
+        return PUBLISH.publish(self.repository, self.payload_root, self.keys, version,
+                               allow_temporary_keys=True, **kwargs)
+
+    def source(self, current_version, repository=None, trusted_root=None):
+        repository = repository or self.repository
+        trusted_root = trusted_root or (Path(repository) / 'trusted-root.json')
+        return update_source.UpdateSource(
+            self.cache / 'metadata', self.cache / 'targets',
+            transport=RepositoryTransport(repository),
+            trusted_root=update_source.load_trusted_root(trusted_root),
+            current_version=current_version)
+
+    def assert_user_data_untouched(self):
+        for name, text in self.user_files.items():
+            self.assertEqual(_read(self.install_root / name), text, name)
+        self.assertEqual(_read(self.install_root / '旧版独有.py'), 'LEGACY = "keep"\n')
+
+
+class FullChainTests(PipelineCase):
+    def test_signed_repository_installs_program_and_keeps_user_data(self):
+        summary = self.publish('0.9')
+        self.assertEqual(summary['target'], 'program-win_amd64.zip')
+        self.assertIn(summary['signer_backend'], ('cryptography', 'vendored-ed25519'))
+        original_socket = socket.socket
+
+        def deny(*_args, **_kwargs):
+            raise AssertionError('升级链路必须使用注入传输，不得打开 socket')
+
+        socket.socket = deny
+        try:
+            result = update_installer.install_update(self.source('0.8'), self.install_root)
+        finally:
+            socket.socket = original_socket
+        self.assertEqual(result['status'], 'installed')
+        self.assertEqual(result['release']['app_version'], '0.9')
+        self.assertEqual(_read(self.install_root / 'app.py'), 'APP = "new"\n')
+        self.assertEqual(_read(self.install_root / 'ui' / 'desktop.py'), 'DESKTOP = "new"\n')
+        self.assertEqual(_read(self.install_root / 'infra' / 'update_notice.py'),
+                         'NOTICE = "new"\n')
+        self.assert_user_data_untouched()
+        self.assertEqual(_read(self.install_root / 'config.json'), self.user_files['config.json'])
+
+    def test_current_version_returns_without_download(self):
+        self.publish('0.9')
+        result = update_installer.install_update(self.source('0.9'), self.install_root)
+        self.assertEqual(result['status'], 'current')
+        self.assertEqual(_read(self.install_root / 'app.py'), 'APP = "old"\n')
+
+    def test_downgrade_target_is_rejected_before_install(self):
+        self.publish('0.7.1')
+        with self.assertRaises(update_source.DowngradeRejected):
+            update_installer.install_update(self.source('0.9'), self.install_root)
+        self.assertEqual(_read(self.install_root / 'app.py'), 'APP = "old"\n')
+
+    def test_second_release_bumps_metadata_versions(self):
+        first = self.publish('0.9')
+        second = self.publish('0.9.1')
+        self.assertEqual(second['targets_version'], first['targets_version'] + 1)
+        self.assertEqual(second['snapshot_version'], first['snapshot_version'] + 1)
+        self.assertEqual(second['timestamp_version'], first['timestamp_version'] + 1)
+
+
+class RejectionTests(PipelineCase):
