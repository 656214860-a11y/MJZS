/程序/writing/
/程序/data/
/程序/配置/宠物/配置.json
/程序/配置/SKILL/预设.json

# 密钥与私有配置。
/程序/private/
/程序/.env
/程序/config.json
/安装信息.json

# 运行日志、缓存和本机维护记录。
/程序/logs/
/维护记录/
/程序/维护记录/*
!/程序/维护记录/UI统一入口路线图_v1.md
/程序/tasks/
/程序/tasks_round/
/程序/_supervisor/
/程序/_diag_*.py
/程序/_diag_*.ps1
*.log
*.bak_*
