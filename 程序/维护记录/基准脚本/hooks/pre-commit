#!/bin/sh
# 由 install_git_hooks.py 安装到 Git common-dir/hooks/pre-commit。
# CODEX_STAGE_ALLOWLIST 使用分号分隔 repo 相对路径；只对非默认安全文档路径必填。
common=$(git rev-parse --git-common-dir) || exit 1
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
# 验收锁只拦 master/main 与游离 HEAD；工作分支随手提交不等锁。
# 超长全量不创建这把锁，只持有 full-safe-runner.lock，避免十几分钟卡住提交。
case "$branch" in
  ""|master|main)
    if [ -e "$common/full-safe-selftest.lock" ]; then
      echo "拒绝提交：全量安全验收锁存在。等待验收结束；异常退出的锁须确认持有人已退出后回收。" >&2
      exit 1
    fi ;;
esac
allowed=";${CODEX_STAGE_ALLOWLIST:-};"
staged=$(mktemp "${TMPDIR:-/tmp}/codex-staged.XXXXXX") || exit 1
trap 'rm -f "$staged"' EXIT HUP INT TERM
git -c core.quotepath=false diff --cached --name-only > "$staged"

# 规则 34a：功能源码只经工作树分支合入 master，禁止在 master 上直接提交（合并提交除外）。
# 判定依据：HEAD 在 master/main 且本次不是合并（无 MERGE_HEAD）时，任何非默认安全文档的
# 程序/ 文件都视为「主工作区直接开发」，予以拒绝。合并提交（git merge/回合）会设置 MERGE_HEAD，
# 不受此限制；文档轮与结果补记只提交下面白名单里的文件，也不受此限制。
case "$branch" in
  ""|master|main)
    if [ ! -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
      while IFS= read -r path; do
        case "$path" in
          程序/tasks_round/tasks_round_*_result.md|程序/project_status.md|程序/维护记录/任务队列.json) continue ;;
          程序/*)
            echo "拒绝提交：规则 34a——主工作区只做同步/合并/提交，禁止在 master 上直接开发功能源码。" >&2
            echo "请改为在功能工作树（git worktree add -b codex/<任务>）中开发，再回合 master；" >&2
            echo "文档轮/结果补记只可提交 tasks_round/project_status.md/任务队列.json。" >&2
            echo "违规文件：$path" >&2
            exit 1 ;;
        esac
      done < "$staged"
    fi ;;
esac

while IFS= read -r path; do
  case "$path" in
    程序/*) ;;
    *) continue ;;
  esac
  if [ "$path" = "程序/project_status.md" ] && [ "$branch" != "master" ]; then
    echo "拒绝提交：只有 master 可更新 程序/project_status.md；工作树只写 tasks_round。" >&2
    exit 1
  fi
  case "$path" in
    程序/tasks_round/tasks_round_*_result.md|程序/project_status.md|程序/维护记录/任务队列.json)
      continue ;;
  esac
  case "$allowed" in
    *";$path;"*) continue ;;
    *)
      echo "拒绝提交：$path 未在 CODEX_STAGE_ALLOWLIST 中。请显式列出本轮文件，勿用 git add -A。" >&2
      exit 1 ;;
  esac
done < "$staged"

# G1 静态门禁：暂存了 程序/*.py 时跑静态名字与静态卫生检查（约 6 秒），不过即拒绝提交。
# 用了没定义的名字＝用户侧 NameError，必须在提交前拦下；没有跳过开关。解释器找不到时只警告（环境问题不阻塞提交）。
if grep -q '^程序/.*\.py$' "$staged" && [ -f "$(git rev-parse --show-toplevel)/程序/tests/test_static_names.py" ]; then
  top=$(git rev-parse --show-toplevel)
  common_root=$(dirname "$(cd "$common" && pwd)")
  py=""
  for candidate in "$top/运行环境/Python/python.exe" "$common_root/运行环境/Python/python.exe"; do
    if [ -x "$candidate" ]; then py="$candidate"; break; fi
  done
  [ -n "$py" ] || py=$(command -v python || command -v python3 || true)
  if [ -z "$py" ]; then
    echo "警告：找不到 Python 解释器，已跳过静态门禁。" >&2
  else
    case "$py" in *.exe) sep=";" ;; *) sep=":" ;; esac
    if ! out=$(cd "$top/程序" && PYTHONPATH="tests${sep}." PYTHONDONTWRITEBYTECODE=1 "$py" -B -m unittest \
        tests.test_static_names tests.architecture.test_static_hygiene 2>&1); then
      echo "拒绝提交：静态门禁未通过（tests.test_static_names、tests.architecture.test_static_hygiene）。" >&2
      printf '%s\n' "$out" | tail -n 15 >&2
      exit 1
    fi
  fi
fi
