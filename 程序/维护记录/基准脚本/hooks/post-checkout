#!/bin/sh
# 只在 Codex 新建会话工作树时接上分支。已有检出的显式 detach、CI 和验收快照保留原语义。
case "$1:$3" in
  0000000000000000000000000000000000000000:1) ;;
  *) exit 0 ;;
esac
git symbolic-ref -q HEAD >/dev/null && exit 0
root=$(git rev-parse --show-toplevel) || exit 1
common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
parent=${root%/*}
id=${parent##*/}
case "$id" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *) exit 0 ;;
esac
case "$parent" in
  */.codex/worktrees/"$id") ;;
  *) exit 0 ;;
esac
repo=${common%/.git}
[ "${root##*/}" = "${repo##*/}" ] || exit 0
git switch -c "codex/worktree-$id"
